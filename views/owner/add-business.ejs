// =====================================================
// HOURS
// =====================================================

function parseTimeParts(value) {

    const raw = String(value || "").trim();

    let match =
        raw.match(/^([01]?\d|2[0-3]):([0-5]\d)$/);

    if (match) {

        const h = Number(match[1]);

        return {
            hour: String(h % 12 || 12),
            minute: match[2],
            period: h >= 12 ? "PM" : "AM"
        };

    }

    match =
        raw.match(/^(\d{1,2}):(\d{2})\s*(AM|PM)$/i);

    if (match) {

        let h = Number(match[1]);

        if (h < 1 || h > 12) {
            h = 12;
        }

        return {
            hour: String(h),
            minute: match[2],
            period: match[3].toUpperCase()
        };

    }

    return {
        hour: "12",
        minute: "00",
        period: "AM"
    };

}


function timePartsTo24(hour, minute, period) {

    let h = Number(hour);

    if (!Number.isFinite(h) || h < 1 || h > 12) {
        h = 12;
    }

    if (period === "AM") {
        h = h === 12 ? 0 : h;
    } else {
        h = h === 12 ? 12 : h + 12;
    }

    return (
        String(h).padStart(2, "0") +
        ":" +
        String(minute).padStart(2, "0")
    );

}


function createTimeSelects(prefix, value) {

    const parts = parseTimeParts(value);

    const hourOptions =
        Array.from({length: 12}, (_, i) => {

            const h = String(i + 1);

            return `
                <option
                    value="${h}"
                    ${h === parts.hour ? "selected" : ""}
                >
                    ${h}
                </option>
            `;

        }).join("");


    const minuteOptions =
        Array.from({length: 60}, (_, i) => {

            const m = String(i).padStart(2, "0");

            return `
                <option
                    value="${m}"
                    ${m === parts.minute ? "selected" : ""}
                >
                    ${m}
                </option>
            `;

        }).join("");


    return `
        <div class="time-group">
            <div>
                <span class="time-label">Hour</span>
                <select data-time="${prefix}-hour">
                    ${hourOptions}
                </select>
            </div>

            <div>
                <span class="time-label">Minute</span>
                <select data-time="${prefix}-minute">
                    ${minuteOptions}
                </select>
            </div>

            <div>
                <span class="time-label">AM / PM</span>
                <select data-time="${prefix}-period">
                    <option value="AM"
                        ${parts.period === "AM" ? "selected" : ""}>
                        AM
                    </option>
                    <option value="PM"
                        ${parts.period === "PM" ? "selected" : ""}>
                        PM
                    </option>
                </select>
            </div>
        </div>
    `;

}


function createPeriodHTML(day, periodNumber, period, options = {}) {

        const suffix =
            periodNumber === 1
                ? "period1"
                : "period2";

        const open =
            period && period.open
                ? period.open
                : "";

        const close =
            period && period.close
                ? period.close
                : "";

        const second =
            periodNumber === 2;

        const showRemove =
            Boolean(options.showRemove);

        return `
            <div class="hours-period">

                <div class="period-title">
                    ${second
                        ? "Period 2 (optional)"
                        : "Business Hours"}
                </div>

                ${createTimeSelects(
                    `${day}-${suffix}-open`,
                    open
                )}

                ${createTimeSelects(
                    `${day}-${suffix}-close`,
                    close
                )}

                ${second
                    ? `<div class="period-help">
                           Use this only if the business closes and reopens later.
                       </div>`
                    : `<div class="period-help">
                           Example: 6:00 AM – 10:00 PM
                       </div>`}

                ${showRemove
                    ? `<div class="period-actions">
                           <button
                               type="button"
                               class="remove-period-btn"
                               data-remove-period="${day}"
                           >
                               − Remove second timing
                           </button>
                       </div>`
                    : ""}

            </div>
        `;

    }


function readPeriod(day, periodNumber, row) {

    const suffix =
        periodNumber === 1
            ? "period1"
            : "period2";


    const openHour =
        row.querySelector(
            `[data-time="${day}-${suffix}-open-hour"]`
        );

    const openMinute =
        row.querySelector(
            `[data-time="${day}-${suffix}-open-minute"]`
        );

    const openPeriod =
        row.querySelector(
            `[data-time="${day}-${suffix}-open-period"]`
        );

    const closeHour =
        row.querySelector(
            `[data-time="${day}-${suffix}-close-hour"]`
        );

    const closeMinute =
        row.querySelector(
            `[data-time="${day}-${suffix}-close-minute"]`
        );

    const closePeriod =
        row.querySelector(
            `[data-time="${day}-${suffix}-close-period"]`
        );


    if (
        !openHour ||
        !openMinute ||
        !openPeriod ||
        !closeHour ||
        !closeMinute ||
        !closePeriod
    ) {
        return {
            open: "",
            close: ""
        };
    }


    const unused =
        periodNumber === 2 &&
        openHour.value === "12" &&
        openMinute.value === "00" &&
        openPeriod.value === "AM" &&
        closeHour.value === "12" &&
        closeMinute.value === "00" &&
        closePeriod.value === "AM";


    if (unused) {
        return {
            open: "",
            close: ""
        };
    }


    return {

        open:
            timePartsTo24(
                openHour.value,
                openMinute.value,
                openPeriod.value
            ),

        close:
            timePartsTo24(
                closeHour.value,
                closeMinute.value,
                closePeriod.value
            )

    };

}


function updateHoursRowState(row) {

    const closed =
        row.querySelector(
            '[data-part="closed"]'
        ).checked;


    row.classList.toggle(
        "hours-row-disabled",
        closed
    );


    row
        .querySelectorAll(".time-group select")
        .forEach(function(select) {
            select.disabled = closed;
        });

}



function renderHours() {

    document.getElementById("hoursBox").innerHTML =

        days.map(

            (day, index) => `

                <div
                    class="hours"
                    data-day="${day}"
                >

                    <span class="day">
                        ${dayLabels[index]}
                    </span>

                    <div
                        class="hours-periods"
                        data-periods="${day}"
                    >

                        ${createPeriodHTML(
                            day,
                            1
                        )}

                        <div class="period-actions">
                            <button
                                type="button"
                                class="add-period-btn"
                                data-add-period="${day}"
                            >
                                + Add another timing
                            </button>
                        </div>

                    </div>

                    <label class="closed-label">
                        <input
                            type="checkbox"
                            data-day="${day}"
                            data-part="closed"
                        >
                        Closed
                    </label>

                </div>

            `

        ).join("");


    document
        .querySelectorAll(
            "#hoursBox select"
        )
        .forEach(function(select) {

            select.addEventListener(
                "change",
                updateHours
            );

        });


    document
        .querySelectorAll(
            '#hoursBox input[type="checkbox"]'
        )
        .forEach(function(checkbox) {

            checkbox.addEventListener(
                "change",
                function() {

                    updateHoursRowState(
                        checkbox.closest(".hours")
                    );

                    updateHours();

                }
            );

        });


    document
        .querySelectorAll(
            "[data-add-period]"
        )
        .forEach(function(button) {

            button.addEventListener(
                "click",
                function() {

                    addSecondPeriod(
                        button.dataset.addPeriod
                    );

                }
            );

        });


    updateHours();

}


function addSecondPeriod(day) {

    const row =
        document.querySelector(
            `.hours[data-day="${day}"]`
        );

    if (!row) {
        return;
    }

    const periodsBox =
        row.querySelector(
            `.hours-periods[data-periods="${day}"]`
        );

    if (!periodsBox) {
        return;
    }

    if (
        periodsBox.querySelector(
            `[data-time="${day}-period2-open-hour"]`
        )
    ) {
        return;
    }

    const addButton =
        periodsBox.querySelector(
            "[data-add-period]"
        );

    if (addButton) {
        addButton.parentElement.remove();
    }

    periodsBox.insertAdjacentHTML(
        "beforeend",
        createPeriodHTML(
            day,
            2
        )
    );

    const newSelects =
        periodsBox.querySelectorAll("select");

    newSelects.forEach(function(select) {

        select.addEventListener(
            "change",
            updateHours
        );

    });

    const removeContainer =
        document.createElement("div");

    removeContainer.className =
        "period-actions";

    removeContainer.innerHTML = `
        <button
            type="button"
            class="remove-period-btn"
            data-remove-period="${day}"
        >
            − Remove second timing
        </button>
    `;

    periodsBox.appendChild(
        removeContainer
    );

    removeContainer
        .querySelector("button")
        .addEventListener(
            "click",
            function() {

                removeSecondPeriod(day);

            }
        );

    updateHours();

}


function removeSecondPeriod(day) {

    const row =
        document.querySelector(
            `.hours[data-day="${day}"]`
        );

    if (!row) {
        return;
    }

    const periodsBox =
        row.querySelector(
            `.hours-periods[data-periods="${day}"]`
        );

    if (!periodsBox) {
        return;
    }

    const secondPeriod =
        periodsBox.querySelector(
            ".hours-period:nth-child(2)"
        );

    if (secondPeriod) {
        secondPeriod.remove();
    }

    const removeButtonContainer =
        periodsBox.querySelector(
            ".remove-period-btn"
        );

    if (removeButtonContainer) {
        removeButtonContainer.parentElement.remove();
    }

    if (
        !periodsBox.querySelector(
            "[data-add-period]"
        )
    ) {

        periodsBox.insertAdjacentHTML(
            "beforeend",
            `
                <div class="period-actions">
                    <button
                        type="button"
                        class="add-period-btn"
                        data-add-period="${day}"
                    >
                        + Add another timing
                    </button>
                </div>
            `
        );

        periodsBox
            .querySelector(
                "[data-add-period]"
            )
            .addEventListener(
                "click",
                function() {

                    addSecondPeriod(
                        day
                    );

                }
            );

    }

    updateHours();

}


function updateHours() {

    const result = {};


    days.forEach(function(day) {

        const row =
            document.querySelector(
                `.hours[data-day="${day}"]`
            );


        if (!row) {
            return;
        }


        const period1 =
            readPeriod(
                day,
                1,
                row
            );


        const period2 =
            readPeriod(
                day,
                2,
                row
            );


        const periods = [period1];


        if (
            period2.open ||
            period2.close
        ) {
            periods.push(period2);
        }


        result[day] = {

            open: period1.open,
            close: period1.close,

            periods: periods,

            closed:
                row.querySelector(
                    '[data-part="closed"]'
                ).checked

        };

    });


    document.getElementById("hours").value =
        JSON.stringify(result);

}


renderHours();

