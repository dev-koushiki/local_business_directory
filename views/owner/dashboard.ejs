<!-- =========================================================
     PHOTO CAROUSEL JAVASCRIPT
========================================================= -->

<script>

function changePhoto(button, direction) {


    /* =====================================================
       GET CAROUSEL
    ====================================================== */

    const carousel =
        button.closest(".carousel");


    if (!carousel) {

        return;

    }



    /* =====================================================
       GET IMAGE
    ====================================================== */

    const image =
        carousel.querySelector(
            ".carousel-image"
        );



    /* =====================================================
       GET COUNTER
    ====================================================== */

    const counter =
        carousel.querySelector(
            ".photo-counter"
        );



    /* =====================================================
       READ IMAGES
    ====================================================== */

    let images;


    try {

        images =
            JSON.parse(
                carousel.dataset.images
            );

    } catch (error) {

        console.error(
            "Could not read business images:",
            error
        );

        return;

    }



    /* =====================================================
       VALIDATE
    ====================================================== */

    if (
        !images ||
        images.length === 0
    ) {

        return;

    }



    /* =====================================================
       CURRENT INDEX
    ====================================================== */

    let currentIndex =
        parseInt(
            carousel.dataset.index || "0",
            10
        );



    /* =====================================================
       CHANGE INDEX
    ====================================================== */

    currentIndex += direction;



    /* =====================================================
       LOOP BACKWARD
    ====================================================== */

    if (currentIndex < 0) {

        currentIndex =
            images.length - 1;

    }



    /* =====================================================
       LOOP FORWARD
    ====================================================== */

    if (
        currentIndex >= images.length
    ) {

        currentIndex = 0;

    }



    /* =====================================================
       SAVE INDEX
    ====================================================== */

    carousel.dataset.index =
        currentIndex;



    /* =====================================================
       CHANGE IMAGE
    ====================================================== */

    image.style.opacity = "0";


    setTimeout(
        function () {

            image.src =
                images[currentIndex];

            image.style.opacity =
                "1";

        },
        100
    );



    /* =====================================================
       UPDATE COUNTER
    ====================================================== */

    if (counter) {

        counter.textContent =
            (currentIndex + 1) +
            " / " +
            images.length;

    }

}

</script>


</body>

</html>