                                <button
                                    type="submit"
                                    class="delete-button"
                                >

                                    🗑️

                                    Delete Business

                                </button>

                            </form>


                        </div>


                    </div>


                </article>


            <% }); %>


        <% } else { %>


            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

