<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Owner Dashboard | Local Business
    </title>


    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >


    <style>

        /* =====================================================
           RESET
        ====================================================== */

        * {
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {
            margin: 0;

            font-family: "Inter", Arial, sans-serif;

            background: #f7f5f3;

            color: #171717;

            min-height: 100vh;
        }


        a {
            text-decoration: none;
        }


        button,
        input,
        select {
            font-family: inherit;
        }



        /* =====================================================
           HEADER
        ====================================================== */

        .owner-header {

            position: sticky;

            top: 0;

            z-index: 1000;

            width: 100%;

            background: #1b1919;

            border-bottom: 1px solid #1b1919;

            box-shadow:
                0 4px 20px rgba(0, 0, 0, 0.18);

        }


        .owner-header-inner {

            max-width: 1200px;

            margin: 0 auto;

            min-height: 76px;

            padding: 0 28px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

        }



        /* =====================================================
           BRAND
        ====================================================== */

        .owner-brand {

            display: flex;

            align-items: center;

            gap: 12px;

            color: #ffffff;

        }


        .owner-brand-icon {

            width: 42px;

            height: 42px;

            border-radius: 11px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #ff6f61;

            color: #ffffff;

            font-size: 13px;

            font-weight: 800;

            letter-spacing: -0.5px;

        }


        .owner-brand-text {

            display: flex;

            flex-direction: column;

            gap: 2px;

        }


        .owner-brand-name {

            font-size: 16px;

            font-weight: 800;

            line-height: 1.1;

        }


        .owner-brand-subtitle {

            color: #ffb0a8;

            font-size: 11px;

            font-weight: 500;

        }



        /* =====================================================
           HEADER RIGHT
        ====================================================== */

        .owner-header-right {

            display: flex;

            align-items: center;

            gap: 16px;

        }


        .owner-user-label {

            color: #d7d2d0;

            font-size: 13px;

            font-weight: 500;

        }


        .logout-button {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            min-height: 42px;

            padding: 0 18px;

            border-radius: 9px;

            background: #ff6f61;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;

        }


        .logout-button:hover {

            background: #ff584b;

            transform: translateY(-1px);

            box-shadow:
                0 7px 18px rgba(255, 111, 97, 0.28);

        }



        /* =====================================================
           MAIN
        ====================================================== */

        .owner-main {

            width: 100%;

            padding: 46px 20px 70px;

        }


        .owner-container {

            width: min(1200px, 100%);

            margin: 0 auto;

        }



        /* =====================================================
           PAGE INTRO
        ====================================================== */

        .owner-page-intro {

            display: flex;

            align-items: flex-end;

            justify-content: space-between;

            gap: 25px;

            margin-bottom: 35px;

        }


        .owner-page-label {

            display: inline-flex;

            align-items: center;

            gap: 7px;

            margin-bottom: 10px;

            color: #8b3a3a;

            font-size: 11px;

            font-weight: 800;

            letter-spacing: 1.3px;

            text-transform: uppercase;

        }


        .owner-page-label::before {

            content: "";

            width: 7px;

            height: 7px;

            border-radius: 50%;

            background: #8b3a3a;

        }


        .owner-page-title {

            margin: 0 0 8px;

            font-size: clamp(28px, 4vw, 38px);

            line-height: 1.12;

            letter-spacing: -1px;

            font-weight: 800;

            color: #171717;

        }


        .owner-page-description {

            margin: 0;

            color: #77716d;

            font-size: 14px;

            line-height: 1.6;

        }



        /* =====================================================
           ADD BUSINESS
        ====================================================== */

        .add-business-button {

            flex-shrink: 0;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 9px;

            min-height: 47px;

            padding: 0 21px;

            border-radius: 9px;

            background: #8b3a3a;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            box-shadow:
                0 7px 18px rgba(139, 58, 58, 0.16);

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;

        }


        .add-business-button:hover {

            background: #6f2d2d;

            transform: translateY(-2px);

            box-shadow:
                0 10px 24px rgba(139, 58, 58, 0.22);

        }


        .add-icon {

            font-size: 18px;

            line-height: 1;

        }



        /* =====================================================
           DASHBOARD SUMMARY
        ====================================================== */

        .dashboard-summary {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 16px;

            margin-bottom: 30px;

        }


        .summary-card {

            padding: 20px;

            background: #ffffff;

            border: 1px solid #ebe7e4;

            border-radius: 13px;

            display: flex;

            align-items: center;

            gap: 15px;

            box-shadow:
                0 6px 22px rgba(0, 0, 0, 0.035);

        }


        .summary-icon {

            width: 43px;

            height: 43px;

            border-radius: 10px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #f6eaea;

            color: #8b3a3a;

            font-size: 19px;

            flex-shrink: 0;

        }


        .summary-content {

            display: flex;

            flex-direction: column;

            gap: 3px;

        }


        .summary-number {

            font-size: 21px;

            font-weight: 800;

            color: #171717;

        }


        .summary-label {

            color: #85807c;

            font-size: 12px;

            font-weight: 500;

        }



        /* =====================================================
           SECTION TITLE
        ====================================================== */

        .business-section-header {

            display: flex;

            align-items: center;

            justify-content: space-between;

            margin-bottom: 17px;

        }


        .business-section-title {

            margin: 0;

            font-size: 18px;

            font-weight: 750;

            color: #24211f;

        }


        .business-section-count {

            color: #8a8480;

            font-size: 12px;

            font-weight: 500;

        }



        /* =====================================================
           BUSINESS CARD
        ====================================================== */

        .business-card {

            overflow: hidden;

            margin-bottom: 24px;

            background: #ffffff;

            border: 1px solid #eae6e3;

            border-radius: 16px;

            box-shadow:
                0 10px 35px rgba(0, 0, 0, 0.055);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;

        }


        .business-card:hover {

            transform: translateY(-2px);

            box-shadow:
                0 15px 42px rgba(0, 0, 0, 0.075);

        }



        /* =====================================================
           PHOTO CAROUSEL
        ====================================================== */

        .carousel {

            position: relative;

            width: 100%;

            height: 340px;

            overflow: hidden;

            background: #eee8e4;

        }


        .carousel-image {

            width: 100%;

            height: 100%;

            display: block;

            object-fit: cover;

            transition:
                opacity 0.2s ease;

        }


        .carousel::after {

            content: "";

            position: absolute;

            left: 0;

            right: 0;

            bottom: 0;

            height: 100px;

            pointer-events: none;

            background:
                linear-gradient(
                    to top,
                    rgba(0,0,0,0.35),
                    transparent
                );

        }



        /* =====================================================
           CAROUSEL BUTTONS
        ====================================================== */

        .carousel-button {

            position: absolute;

            top: 50%;

            z-index: 5;

            transform: translateY(-50%);

            width: 44px;

            height: 44px;

            border: 1px solid rgba(255,255,255,0.25);

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            background: rgba(20,20,20,0.55);

            color: #ffffff;

            font-size: 20px;

            line-height: 1;

            cursor: pointer;

            backdrop-filter: blur(6px);

            transition:
                background 0.2s ease,
                transform 0.2s ease;

        }


        .carousel-button:hover {

            background: rgba(20,20,20,0.82);

        }


        .carousel-prev {

            left: 18px;

        }


        .carousel-next {

            right: 18px;

        }


        .carousel-prev:hover {

            transform:
                translateY(-50%) translateX(-2px);

        }


        .carousel-next:hover {

            transform:
                translateY(-50%) translateX(2px);

        }


        .carousel.single-image
        .carousel-button {

            display: none;

        }



        /* =====================================================
           PHOTO COUNTER
        ====================================================== */

        .photo-counter {

            position: absolute;

            z-index: 10;

            left: 18px;

            bottom: 16px;

            padding: 7px 11px;

            border-radius: 20px;

            background: rgba(20,20,20,0.62);

            color: #ffffff;

            font-size: 11px;

            font-weight: 600;

            backdrop-filter: blur(5px);

        }



        /* =====================================================
           BUSINESS DETAILS
        ====================================================== */

        .business-content {

            padding: 27px 30px 30px;

        }


        .business-top {

            display: flex;

            align-items: flex-start;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 17px;

        }


        .business-name {

            margin: 0;

            font-size: 25px;

            line-height: 1.25;

            font-weight: 800;

            letter-spacing: -0.4px;

            color: #171717;

        }


        .category {

            flex-shrink: 0;

            padding: 7px 11px;

            border-radius: 20px;

            background: #f6eaea;

            color: #8b3a3a;

            font-size: 11px;

            font-weight: 700;

        }


        .description {

            margin: 0 0 22px;

            color: #68625e;

            font-size: 14px;

            line-height: 1.7;

        }



        /* =====================================================
           INFO GRID
        ====================================================== */

        .business-info-grid {

            display: grid;

            grid-template-columns:
                repeat(2, minmax(0, 1fr));

            gap: 10px;

            margin-bottom: 24px;

        }


        .info {

            min-width: 0;

            display: flex;

            align-items: flex-start;

            gap: 10px;

            padding: 12px 13px;

            border: 1px solid #eeeae7;

            border-radius: 9px;

            background: #fbfaf9;

            color: #57524f;

            font-size: 12px;

            line-height: 1.5;

        }


        .info-icon {

            flex-shrink: 0;

            font-size: 15px;

        }


        .info-text {

            min-width: 0;

            overflow-wrap: anywhere;

        }


        .info a {

            color: #8b3a3a;

            font-weight: 600;

            overflow-wrap: anywhere;

        }


        .info a:hover {

            text-decoration: underline;

        }



        /* =====================================================
           ACTIONS
        ====================================================== */

        .actions {

            display: flex;

            align-items: center;

            gap: 10px;

            padding-top: 3px;

            border-top: 1px solid #eeeae7;

        }


        .edit-button,
        .delete-button {

            min-height: 40px;

            padding: 0 17px;

            border-radius: 8px;

            display: inline-flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            font-size: 12px;

            font-weight: 700;

            transition:
                background 0.2s ease,
                transform 0.2s ease;

        }


        .edit-button {

            background: #8b3a3a;

            color: #ffffff;

        }


        .edit-button:hover {

            background: #6f2d2d;

            transform: translateY(-1px);

        }


        .delete-form {

            margin: 0;

        }


        .delete-button {

            border: 1px solid #f0cccc;

            background: #fff7f7;

            color: #b42323;

            cursor: pointer;

        }


        .delete-button:hover {

            background: #feeaea;

            border-color: #e7aaaa;

            transform: translateY(-1px);

        }



        /* =====================================================
           EMPTY STATE
        ====================================================== */

        .no-business {

            padding: 65px 30px;

            text-align: center;

            background: #ffffff;

            border: 1px solid #eae6e3;

            border-radius: 16px;

            box-shadow:
                0 10px 35px rgba(0,0,0,0.045);

        }


        .empty-icon {

            width: 64px;

            height: 64px;

            margin: 0 auto 18px;

            border-radius: 16px;

            display: flex;

            align-items: center;

            justify-content: center;

            background: #f6eaea;

            color: #8b3a3a;

            font-size: 27px;

        }


        .no-business h3 {

            margin: 0 0 9px;

            font-size: 21px;

            font-weight: 800;

            color: #24211f;

        }


        .no-business p {

            max-width: 450px;

            margin: 0 auto 24px;

            color: #77716d;

            font-size: 13px;

            line-height: 1.6;

        }


        .empty-add-button {

            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-height: 43px;

            padding: 0 18px;

            border-radius: 8px;

            background: #8b3a3a;

            color: #ffffff;

            font-size: 12px;

            font-weight: 700;

        }


        .empty-add-button:hover {

            background: #6f2d2d;

        }



        /* =====================================================
           FOOTER
        ====================================================== */

        .owner-footer {

            padding: 24px 20px;

            border-top: 1px solid #e8e3df;

            background: #ffffff;

        }


        .owner-footer-inner {

            max-width: 1200px;

            margin: 0 auto;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

        }


        .owner-footer p {

            margin: 0;

            color: #938d89;

            font-size: 11px;

        }


        .owner-footer-brand {

            color: #8b3a3a;

            font-size: 11px;

            font-weight: 700;

        }



        /* =====================================================
           RESPONSIVE
        ====================================================== */

        @media (max-width: 800px) {

            .owner-header-inner {

                min-height: 68px;

                padding: 0 17px;

            }


            .owner-user-label {

                display: none;

            }


            .owner-main {

                padding:
                    32px 15px 50px;

            }


            .owner-page-intro {

                align-items: stretch;

                flex-direction: column;

                margin-bottom: 28px;

            }


            .add-business-button {

                width: 100%;

            }


            .dashboard-summary {

                grid-template-columns:
                    1fr;

            }


            .carousel {

                height: 280px;

            }


            .business-content {

                padding:
                    22px 20px 23px;

            }


            .business-top {

                flex-direction: column;

                gap: 11px;

            }


            .business-name {

                font-size: 22px;

            }


            .business-info-grid {

                grid-template-columns:
                    1fr;

            }


            .owner-footer-inner {

                flex-direction: column;

                text-align: center;

            }

        }


        @media (max-width: 500px) {

            .owner-brand-text {

                display: none;

            }


            .owner-brand-icon {

                width: 40px;

                height: 40px;

            }


            .logout-button {

                min-height: 39px;

                padding: 0 14px;

            }


            .owner-page-title {

                font-size: 29px;

            }


            .carousel {

                height: 220px;

            }


            .carousel-button {

                width: 38px;

                height: 38px;

                font-size: 17px;

            }


            .carousel-prev {

                left: 10px;

            }


            .carousel-next {

                right: 10px;

            }


            .business-content {

                padding:
                    19px 16px 20px;

            }


            .actions {

                flex-direction: column;

                align-items: stretch;

            }


            .edit-button,
            .delete-button {

                width: 100%;

            }


            .delete-form {

                width: 100%;

            }


            .no-business {

                padding:
                    45px 20px;

            }

        }

    </style>

</head>


<body>


<!-- =========================================================
     HEADER
========================================================= -->

<header class="owner-header">

    <div class="owner-header-inner">


        <!-- BRAND -->

        <a
            href="/owner"
            class="owner-brand"
        >

            <span class="owner-brand-icon">
                L
            </span>


            <span class="owner-brand-text">

                <span class="owner-brand-name">
                    Local Business
                </span>

                <span class="owner-brand-subtitle">
                    Owner Portal
                </span>

            </span>

        </a>



        <!-- RIGHT -->

        <div class="owner-header-right">

            <span class="owner-user-label">
                
            </span>


            <a
                href="/logout"
                class="logout-button"
            >

                <span>
                    ↪
                </span>

                Logout

            </a>

        </div>


    </div>

</header>



<!-- =========================================================
     MAIN
========================================================= -->

<main class="owner-main">

    <div class="owner-container">


        <!-- =================================================
             PAGE INTRO
        ================================================== -->

        <section class="owner-page-intro">

            <div>

                <div class="owner-page-label">
                    Owner Dashboard
                </div>


                <h1 class="owner-page-title">
                    Manage your businesses
                </h1>


                <p class="owner-page-description">
                    Manage the businesses you have registered
                    and keep your listings up to date.
                </p>

            </div>


            <a
                href="/owner/business/add"
                class="add-business-button"
            >

                <span class="add-icon">
                    +
                </span>

                Add Business

            </a>

        </section>



        <!-- =================================================
             SUMMARY
        ================================================== -->

        <section class="dashboard-summary">


            <div class="summary-card">

                <div class="summary-icon">
                    🏢
                </div>

                <div class="summary-content">

                    <span class="summary-number">
                        <%= businesses ? businesses.length : 0 %>
                    </span>

                    <span class="summary-label">
                        Registered Businesses
                    </span>

                </div>

            </div>



            <div class="summary-card">

                <div class="summary-icon">
                    📸
                </div>

                <div class="summary-content">

                    <span class="summary-number">

                        <%
                            let totalPhotos = 0;

                            if (businesses) {

                                businesses.forEach(function(business) {

                                    if (
                                        business.images &&
                                        business.images.length
                                    ) {

                                        totalPhotos +=
                                            business.images.length;

                                    }

                                });

                            }
                        %>

                        <%= totalPhotos %>

                    </span>

                    <span class="summary-label">
                        Uploaded Photos
                    </span>

                </div>

            </div>



            <div class="summary-card">

                <div class="summary-icon">
                    ✓
                </div>

                <div class="summary-content">

                    <span class="summary-number">
                        Active
                    </span>

                    <span class="summary-label">
                        Account Status
                    </span>

                </div>

            </div>


        </section>



        <!-- =================================================
             BUSINESS SECTION HEADER
        ================================================== -->

        <div class="business-section-header">

            <h2 class="business-section-title">
                Your Businesses
            </h2>


            <span class="business-section-count">

                <%= businesses ? businesses.length : 0 %>

                listing<%= businesses && businesses.length === 1 ? '' : 's' %>

            </span>

        </div>



        <!-- =================================================
             BUSINESSES
        ================================================== -->

        <% if (businesses && businesses.length > 0) { %>


            <% businesses.forEach(function(business, businessIndex) { %>


                <article class="business-card">


                    <!-- =====================================
                         IMAGE CAROUSEL
                    ====================================== -->

                    <%

                        let businessImages = [];

                        if (
                            business.images &&
                            business.images.length > 0
                        ) {

                            businessImages =
                                business.images;

                        }

                    %>


                    <% if (businessImages.length > 0) { %>


                        <div
                            class="carousel <%= businessImages.length === 1 ? 'single-image' : '' %>"
                            data-images='<%- JSON.stringify(businessImages) %>'
                            data-index="0"
                        >


                            <img
                                class="carousel-image"
                                src="<%= businessImages[0] %>"
                                alt="<%= business.name %>"
                                onerror="this.src='https://via.placeholder.com/1200x400?text=No+Business+Image'"
                            >


                            <!-- PREVIOUS -->

                            <button
                                type="button"
                                class="carousel-button carousel-prev"
                                onclick="changePhoto(this, -1)"
                                aria-label="Previous photo"
                            >

                                &#10094;

                            </button>


                            <!-- NEXT -->

                            <button
                                type="button"
                                class="carousel-button carousel-next"
                                onclick="changePhoto(this, 1)"
                                aria-label="Next photo"
                            >

                                &#10095;

                            </button>


                            <!-- COUNTER -->

                            <div class="photo-counter">

                                1 /
                                <%= businessImages.length %>

                            </div>


                        </div>


                    <% } else { %>


                        <!-- =================================
                             NO IMAGE
                        ================================== -->

                        <div class="carousel">

                            <img
                                class="carousel-image"
                                src="https://via.placeholder.com/1200x400?text=No+Business+Photo"
                                alt="No business photo"
                            >

                        </div>


                    <% } %>



                    <!-- =====================================
                         BUSINESS CONTENT
                    ====================================== -->

                    <div class="business-content">


                        <div class="business-top">


                            <h2 class="business-name">

                                <%= business.name %>

                            </h2>


                            <div class="category">

                                <%= business.category %>

                            </div>


                        </div>



                        <!-- DESCRIPTION -->

                        <% if (business.description) { %>

                            <p class="description">

                                <%= business.description %>

                            </p>

                        <% } %>



                        <!-- =================================
                             INFORMATION
                        ================================== -->

                        <div class="business-info-grid">


                            <!-- ADDRESS -->

                            <div class="info">

                                <span class="info-icon">
                                    📍
                                </span>

                                <span class="info-text">

                                    <%= business.address %>,
                                    <%= business.city %>

                                </span>

                            </div>



                            <!-- PHONE -->

                            <% if (business.phone) { %>

                                <div class="info">

                                    <span class="info-icon">
                                        📞
                                    </span>

                                    <span class="info-text">

                                        <%= business.phone %>

                                    </span>

                                </div>

                            <% } %>



                            <!-- EMAIL -->

                            <% if (business.email) { %>

                                <div class="info">

                                    <span class="info-icon">
                                        ✉️
                                    </span>

                                    <span class="info-text">

                                        <%= business.email %>

                                    </span>

                                </div>

                            <% } %>



                            <!-- WEBSITE -->

