<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>My Business Reviews</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f6f8;
            color: #111;
        }

        /* =========================
           HEADER
        ========================= */

        .header {
            background: #222;
            color: white;

            padding: 25px 50px;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h1 {
            margin: 0;
            font-size: 34px;
        }

        .logout {
            background: #f04f3f;
            color: white;

            text-decoration: none;

            padding: 12px 22px;

            border-radius: 7px;

            font-size: 16px;
        }

        /* =========================
           CONTAINER
        ========================= */

        .container {
            max-width: 1100px;

            margin: 50px auto;

            padding: 0 25px;
        }

        /* =========================
           TOP SECTION
        ========================= */

        .top-section {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 35px;
        }

        .top-section h2 {
            margin: 0 0 10px 0;

            font-size: 30px;
        }

        .top-section p {
            margin: 0;

            font-size: 17px;

            color: #555;
        }

        .back-button {
            background: #087f5b;

            color: white;

            text-decoration: none;

            padding: 13px 20px;

            border-radius: 7px;

            font-size: 16px;
        }

        /* =========================
           REVIEW CARD
        ========================= */

        .review-card {
            background: white;

            padding: 30px;

            border-radius: 12px;

            margin-bottom: 20px;

            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .business-name {
            font-size: 24px;

            font-weight: bold;

            margin-bottom: 15px;

            color: #087f5b;
        }

        .customer {
            font-size: 17px;

            margin-bottom: 12px;
        }

        .customer strong {
            font-weight: bold;
        }

        .rating {
            font-size: 20px;

            margin-bottom: 15px;
        }

        .comment {
            font-size: 18px;

            line-height: 1.6;

            margin-bottom: 15px;
        }

        .date {
            color: #777;

            font-size: 14px;
        }

        /* =========================
           EMPTY STATE
        ========================= */

        .empty {
            background: white;

            padding: 50px;

            border-radius: 12px;

            text-align: center;

            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .empty h3 {
            margin-top: 0;

            font-size: 28px;
        }

        .empty p {
            font-size: 17px;

            color: #555;
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 700px) {

            .header {
                padding: 20px;
            }

            .header h1 {
                font-size: 26px;
            }

            .container {
                margin-top: 30px;
            }

            .top-section {
                flex-direction: column;

                align-items: flex-start;

                gap: 20px;
            }

            .review-card {
                padding: 22px;
            }

            .back-button {
                width: 100%;

                text-align: center;
            }

        }

    </style>

</head>


<body>


<!-- =========================
     HEADER
========================= -->

<header class="header">

    <h1>My Business Reviews</h1>

    <a href="/logout" class="logout">
        Logout
    </a>

</header>


<!-- =========================
     MAIN
========================= -->

<div class="container">


    <!-- TOP SECTION -->

    <div class="top-section">

        <div>

            <h2>
                Customer Reviews
            </h2>

            <p>
                Reviews for your businesses are shown below.
            </p>

        </div>


        <a
            href="/owner"
            class="back-button"
        >
            ← Owner Dashboard
        </a>

    </div>


    <!-- =========================
         REVIEWS
    ========================= -->

    <% if (reviews && reviews.length > 0) { %>


        <% reviews.forEach(review => { %>


            <div class="review-card">


                <!-- BUSINESS -->

                <div class="business-name">

                    🏢

                    <% if (review.business) { %>

                        <%= review.business.name %>

                    <% } else { %>

                        Business

                    <% } %>

                </div>


                <!-- CUSTOMER -->

                <div class="customer">

                    👤

                    <strong>Customer:</strong>

                    <% if (review.user) { %>

                        <%= review.user.name %>

                        <% if (review.user.email) { %>

                            (<%= review.user.email %>)

                        <% } %>

                    <% } else { %>

                        Unknown customer

                    <% } %>

                </div>


                <!-- RATING -->

                <div class="rating">

                    ⭐

                    <strong>
                        <%= review.rating %> / 5
                    </strong>

                </div>


                <!-- COMMENT -->

                <div class="comment">

                    <%= review.comment %>

                </div>


                <!-- DATE -->

                <div class="date">

                    Reviewed on:

                    <%= new Date(review.createdAt).toLocaleDateString() %>

                </div>


            </div>


        <% }); %>


    <% } else { %>


        <!-- EMPTY STATE -->

        <div class="empty">

            <h3>
                No Reviews Yet
            </h3>

            <p>
                Your businesses have not received any reviews yet.
            </p>

            <br>

            <a
                href="/owner"
                class="back-button"
            >
                ← Back to Dashboard
            </a>

        </div>


    <% } %>


</div>


</body>

</html>