<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Reviews | Local Business</title>


    <!-- =========================================================
         GOOGLE FONTS
    ========================================================== -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
        rel="stylesheet"
    >


    <style>

        /* =========================================================
           RESET
        ========================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {
            font-family: "DM Sans", sans-serif;

            background: #f8f5f2;

            color: #171717;

            min-height: 100vh;
        }


        a {
            text-decoration: none;
        }


        /* =========================================================
           NAVBAR
           SAME STYLE AS CUSTOMER PAGE
        ========================================================== */

        .admin-navbar {
            width: 100%;

            height: 82px;

            background: #211f1f;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 7%;

            position: sticky;

            top: 0;

            z-index: 1000;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.12);
        }


        /* =========================================================
           BRAND
        ========================================================== */

        .admin-brand {
            display: flex;

            align-items: center;

            gap: 14px;
        }


        /* LOGO */

        .brand-logo {
            width: 47px;

            height: 47px;

            border-radius: 9px;

            background: #a44141;

            color: #ffffff;

            display: flex;

            align-items: center;

            justify-content: center;

            font-family: "Space Grotesk", sans-serif;

            font-size: 18px;

            font-weight: 700;

            flex-shrink: 0;
        }


        /* =========================================================
           BRAND TEXT
        ========================================================== */

        .brand-text {
            display: flex;

            align-items: center;
        }


        .brand-title {
            font-family: "Space Grotesk", sans-serif;

            font-size: 20px;

            font-weight: 700;

            color: #ffffff;

            letter-spacing: -0.2px;
        }


        /* Admin Portal removed visually */

        .brand-subtitle {
            display: none;
        }


        /* =========================================================
           LOGOUT
        ========================================================== */

        .logout-button {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-width: 105px;

            height: 43px;

            padding: 0 22px;

            border-radius: 9px;

            background: #a44141;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            border: 1px solid #a44141;

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .logout-button:hover {
            background: #8c3636;

            transform: translateY(-2px);

            box-shadow:
                0 8px 20px rgba(164, 65, 65, 0.28);
        }


        /* =========================================================
           MAIN
        ========================================================== */

        .admin-page {
            width: min(1200px, 90%);

            margin: 0 auto;

            padding: 60px 0 90px;
        }


        /* =========================================================
           BACK BUTTON
        ========================================================== */

        .back-button {
            display: inline-flex;

            align-items: center;

            gap: 8px;

            color: #963b3b;

            font-size: 15px;

            font-weight: 700;

            margin-bottom: 30px;

            transition:
                color 0.2s ease,
                transform 0.2s ease;
        }


        .back-button:hover {
            color: #6f2d2d;

            transform: translateX(-3px);
        }


        /* =========================================================
           PAGE HEADER
        ========================================================== */

        .page-header {
            margin-bottom: 38px;
        }


        .page-label {
            display: flex;

            align-items: center;

            gap: 9px;

            color: #963b3b;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            margin-bottom: 12px;
        }


        .page-label::before {
            content: "";

            width: 7px;

            height: 7px;

            border-radius: 50%;

            background: #ff725c;
        }


        .page-header h1 {
            font-family: "Space Grotesk", sans-serif;

            font-size: clamp(36px, 5vw, 52px);

            line-height: 1.05;

            font-weight: 700;

            color: #171717;

            margin-bottom: 12px;
        }


        .page-header p {
            color: #756b66;

            font-size: 16px;

            line-height: 1.6;

            max-width: 680px;
        }


        /* =========================================================
           HERO
        ========================================================== */

        .reviews-hero {
            position: relative;

            overflow: hidden;

            border-radius: 24px;

            padding: 38px 42px;

            margin-bottom: 30px;

            background:
                linear-gradient(
                    120deg,
                    #261719 0%,
                    #4b2527 45%,
                    #91462a 100%
                );

            color: #ffffff;

            box-shadow:
                0 20px 45px rgba(74, 43, 39, 0.16);
        }


        .reviews-hero::before {
            content: "";

            position: absolute;

            width: 230px;

            height: 230px;

            border-radius: 50%;

            border:
                1px solid rgba(255, 255, 255, 0.14);

            right: -55px;

            top: -95px;
        }


        .reviews-hero::after {
            content: "";

            position: absolute;

            width: 140px;

            height: 140px;

            border-radius: 50%;

            background:
                rgba(255, 114, 92, 0.18);

            right: 100px;

            bottom: -80px;

            filter: blur(5px);
        }


        .reviews-hero-content {
            position: relative;

            z-index: 2;
        }


        .reviews-hero h2 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 30px;

            margin-bottom: 8px;
        }


        .reviews-hero p {
            color: rgba(255, 255, 255, 0.78);

            font-size: 15px;

            line-height: 1.6;

            max-width: 850px;
        }


        /* =========================================================
           REVIEWS CARD
        ========================================================== */

        .reviews-card {
            background: #ffffff;

            border: 1px solid #eee5df;

            border-radius: 22px;

            padding: 32px;

            box-shadow:
                0 15px 40px rgba(47, 31, 26, 0.07);

            overflow: hidden;
        }


        /* =========================================================
           CARD HEADER
        ========================================================== */

        .reviews-card-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 26px;
        }


        .reviews-card-header h2 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 27px;

            color: #171717;
        }


        .review-count {
            padding: 8px 15px;

            border-radius: 30px;

            background: #f7e9e5;

            color: #963b3b;

            font-size: 13px;

            font-weight: 700;

            white-space: nowrap;
        }


        /* =========================================================
           TABLE
        ========================================================== */

        .table-wrapper {
            width: 100%;

            overflow-x: auto;

            border: 1px solid #eee5df;

            border-radius: 15px;
        }


        .reviews-table {
            width: 100%;

            border-collapse: collapse;

            min-width: 850px;
        }


        /* TABLE HEADER */

        .reviews-table thead {
            background: #963b3b;
        }


        .reviews-table th {
            padding: 17px 18px;

            text-align: left;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 0.3px;

            white-space: nowrap;
        }


        .reviews-table th:first-child {
            border-top-left-radius: 14px;
        }


        .reviews-table th:last-child {
            border-top-right-radius: 14px;
        }


        /* TABLE BODY */

        .reviews-table td {
            padding: 20px 18px;

            border-bottom:
                1px solid #eee8e3;

            font-size: 14px;

            color: #443c38;

            vertical-align: middle;
        }


        .reviews-table tbody tr {
            background: #ffffff;

            transition:
                background 0.2s ease;
        }


        .reviews-table tbody tr:hover {
            background: #fcf8f5;
        }


        .reviews-table tbody tr:last-child td {
            border-bottom: none;
        }


        /* =========================================================
           CUSTOMER
        ========================================================== */

        .customer-name {
            font-weight: 700;

            color: #211b19;

            margin-bottom: 3px;
        }


        .customer-email {
            color: #857a74;

            font-size: 12px;

            word-break: break-word;
        }


        /* =========================================================
           BUSINESS
        ========================================================== */

        .business-name {
            font-weight: 700;

            color: #963b3b;
        }


        /* =========================================================
           RATING
        ========================================================== */

        .rating-wrapper {
            display: inline-flex;

            align-items: center;

            gap: 7px;

            padding: 7px 11px;

            border-radius: 9px;

            background: #fff7e8;
        }


        .rating-star {
            font-size: 16px;
        }


        .rating-number {
            color: #a76500;

            font-weight: 700;

            font-size: 14px;
        }


        /* =========================================================
           REVIEW TEXT
        ========================================================== */

        .review-text {
            max-width: 280px;

            color: #4c4440;

            line-height: 1.5;

            word-break: break-word;
        }


        /* =========================================================
           DATE
        ========================================================== */

        .review-date {
            color: #756b66;

            white-space: nowrap;

            font-size: 13px;
        }


        /* =========================================================
           DELETE BUTTON
        ========================================================== */

        .delete-form {
            display: inline;
        }


        .delete-button {
            border: none;

            cursor: pointer;

            padding: 10px 16px;

            border-radius: 9px;

            background: #f5e5e2;

            color: #a53b32;

            font-family: inherit;

            font-size: 13px;

            font-weight: 700;

            transition:
                background 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }


        .delete-button:hover {
            background: #a53b32;

            color: #ffffff;

            transform: translateY(-1px);
        }


        /* =========================================================
           EMPTY STATE
        ========================================================== */

        .empty-state {
            padding: 70px 30px;

            text-align: center;
        }


        .empty-icon {
            width: 64px;

            height: 64px;

            margin: 0 auto 18px;

            border-radius: 18px;

            background: #f7e9e5;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 27px;
        }


        .empty-state h3 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 22px;

            margin-bottom: 7px;
        }


        .empty-state p {
            color: #817771;

            font-size: 14px;
        }


        /* =========================================================
           FOOTER
        ========================================================== */

        .admin-footer {
            text-align: center;

            color: #938780;

            font-size: 13px;

            margin-top: 40px;
        }


        /* =========================================================
           RESPONSIVE
        ========================================================== */

        @media (max-width: 800px) {

            .admin-navbar {
                padding: 0 5%;
            }


            .admin-page {
                width: 92%;

                padding-top: 45px;
            }


            .reviews-hero {
                padding: 30px 25px;

                border-radius: 18px;
            }


            .reviews-card {
                padding: 22px;

                border-radius: 18px;
            }


            .reviews-card-header {
                align-items: flex-start;

                flex-direction: column;
            }

        }


        @media (max-width: 550px) {

            .admin-navbar {
                height: 72px;

                padding: 0 18px;
            }


            .brand-logo {
                width: 40px;

                height: 40px;

                border-radius: 8px;

                font-size: 14px;
            }


            .brand-title {
                font-size: 16px;
            }


            .logout-button {
                min-width: auto;

                height: 38px;

                padding: 0 15px;

                font-size: 12px;
            }


            .admin-page {
                width: 94%;

                padding-top: 35px;
            }


            .page-header h1 {
                font-size: 34px;
            }


            .page-header p {
                font-size: 14px;
            }


            .reviews-hero {
                padding: 28px 22px;
            }


            .reviews-hero h2 {
                font-size: 24px;
            }


            .reviews-card {
                padding: 17px;
            }


            .reviews-card-header h2 {
                font-size: 23px;
            }

        }

    </style>

</head>


<body>


    <!-- =========================================================
         NAVBAR
    ========================================================== -->

    <nav class="admin-navbar">


        <a
            href="/admin"
            class="admin-brand"
        >


            <div class="brand-logo">
                L
            </div>


            <div class="brand-text">

                <div class="brand-title">
                    Local Business
                </div>


                <!-- Kept in HTML but hidden -->
                <div class="brand-subtitle">
                    Admin Portal
                </div>

            </div>


        </a>


        <a
            href="/logout"
            class="logout-button"
        >
            Logout
        </a>


    </nav>



    <!-- =========================================================
         MAIN PAGE
    ========================================================== -->

    <main class="admin-page">


        <!-- =====================================================
             BACK
        ====================================================== -->

        <a
            href="/admin"
            class="back-button"
        >
            ← Back to Admin Dashboard
        </a>



        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <section class="page-header">


            <div class="page-label">
                Administration
            </div>


            <h1>
                Manage Reviews
            </h1>


            <p>
                Review customer feedback, monitor ratings,
                and manage reviews submitted for businesses
                on the platform.
            </p>


        </section>



        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="reviews-hero">


            <div class="reviews-hero-content">


                <h2>
                    Customer Feedback
                </h2>


                <p>
                    Keep track of what customers are saying
                    about local businesses and maintain a
                    trusted business directory.
                </p>


            </div>


        </section>



        <!-- =====================================================
             REVIEWS CARD
        ====================================================== -->

        <section class="reviews-card">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="reviews-card-header">


                <h2>
                    All Reviews
                </h2>


                <div class="review-count">

                    <%= reviews.length %>

                    <%= reviews.length === 1
                        ? "Review"
                        : "Reviews"
                    %>

                </div>


            </div>



            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <% if (reviews.length === 0) { %>


                <div class="empty-state">


                    <div class="empty-icon">
                        💬
                    </div>


                    <h3>
                        No Reviews Yet
                    </h3>


                    <p>
                        Customer reviews will appear here
                        once users start sharing their experiences.
                    </p>


                </div>


            <% } else { %>


                <!-- =================================================
                     TABLE
                ================================================== -->

                <div class="table-wrapper">


                    <table class="reviews-table">


                        <thead>


                            <tr>

                                <th>
                                    Customer
                                </th>

                                <th>
                                    Business
                                </th>

                                <th>
                                    Rating
                                </th>

                                <th>
                                    Review
                                </th>

                                <th>
                                    Created
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>


                        </thead>



                        <tbody>


                            <% reviews.forEach(function(review) { %>


                                <tr>


                                    <!-- =================================
                                         CUSTOMER
                                    ================================== -->

                                    <td>


                                        <% if (review.user) { %>


                                            <div class="customer-name">
                                                <%= review.user.name %>
                                            </div>


                                            <div class="customer-email">
                                                <%= review.user.email %>
                                            </div>


                                        <% } else { %>


                                            <div class="customer-name">
                                                Unknown User
                                            </div>


                                            <div class="customer-email">
                                                User account unavailable
                                            </div>


                                        <% } %>


                                    </td>



                                    <!-- =================================
                                         BUSINESS
                                    ================================== -->

                                    <td>


                                        <div class="business-name">


                                            <% if (review.business) { %>

                                                <%= review.business.name %>

                                            <% } else { %>

                                                Unknown Business

                                            <% } %>


                                        </div>


                                    </td>



                                    <!-- =================================
                                         RATING
                                    ================================== -->

                                    <td>


                                        <div class="rating-wrapper">


                                            <span class="rating-star">
                                                ⭐
                                            </span>


                                            <span class="rating-number">
                                                <%= review.rating %>/5
                                            </span>


                                        </div>


                                    </td>



                                    <!-- =================================
                                         REVIEW
                                    ================================== -->

                                    <td>


                                        <div class="review-text">


                                            <% if (review.comment) { %>

                                                <%= review.comment %>

                                            <% } else { %>

                                                No comment provided.

                                            <% } %>


                                        </div>


                                    </td>



                                    <!-- =================================
                                         DATE
                                    ================================== -->

                                    <td>


                                        <div class="review-date">


                                            <%= new Date(
                                                review.createdAt
                                            ).toLocaleDateString("en-GB") %>


                                        </div>


                                    </td>



                                    <!-- =================================
                                         ACTION
                                    ================================== -->

                                    <td>


                                        <form
                                            action="/admin/reviews/delete/<%= review._id %>"
                                            method="POST"
                                            class="delete-form"
                                            onsubmit="return confirm('Are you sure you want to delete this review?');"
                                        >


                                            <button
                                                type="submit"
                                                class="delete-button"
                                            >
                                                Delete
                                            </button>


                                        </form>


                                    </td>


                                </tr>


                            <% }); %>


                        </tbody>


                    </table>


                </div>


            <% } %>


        </section>



        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <div class="admin-footer">

            Local Business Directory · Admin Panel

        </div>


    </main>


</body>

</html>