                    135deg,
                    #fffaf8 0%,
                    #fff4f0 52%,
                    #f9eeee 100%
                );

            box-shadow:
                0 18px 45px rgba(86,52,48,.08),
                inset 0 1px 0 rgba(255,255,255,.9);
        }

        .topbar::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;

            width: 6px;

            border-radius: 24px 0 0 24px;

            background:
                linear-gradient(
                    180deg,
                    #ff765f,
                    #c94e4e
                );

            z-index: -1;
        }

        .topbar::after {
            content: "";
            position: absolute;

            width: 210px;
            height: 210px;

            right: -85px;
            top: -115px;

            border-radius: 50%;

            border: 1px solid rgba(201,78,78,.12);

            box-shadow:
                0 0 0 25px rgba(201,78,78,.035),
                0 0 0 50px rgba(201,78,78,.025);

            pointer-events: none;
        }

        .topbar-left {
            position: relative;
            z-index: 2;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            width: fit-content;

            padding: 7px 12px;

            border: 1px solid #f1cbc3;
            border-radius: 999px;

            background: rgba(255,255,255,.72);

            color: #a0443e;

            box-shadow:
