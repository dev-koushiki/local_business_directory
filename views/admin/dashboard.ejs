<script>
(function () {
    "use strict";

    /*
     * The dashboard gets its numbers from the existing admin pages.
     * This means no database data is hard-coded into the dashboard.
     * Existing routes and functionality remain unchanged.
     */

    const targets = {
        users: document.getElementById("totalUsersCount"),
        owners: document.getElementById("totalOwnersCount"),
        customers: document.getElementById("totalCustomersCount"),
        businesses: document.getElementById("totalBusinessesCount"),
        reviews: document.getElementById("totalReviewsCount")
    };

    function setCount(element, value) {
        if (!element) return;

        const number = Number(value);

        if (Number.isFinite(number)) {
            element.textContent = number.toLocaleString();
        } else {
            element.textContent = "0";
        }
    }

    async function readCount(url, selector, reviewMode) {
        try {
            const response = await fetch(url, {
                method: "GET",
                credentials: "same-origin",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (!response.ok) {
                throw new Error("Request failed");
            }

            const html = await response.text();
            const doc = new DOMParser().parseFromString(html, "text/html");

            const node = doc.querySelector(selector);

            if (node) {
                const raw = node.textContent.trim();
                const match = raw.match(/\d[\d,]*/);

                if (match) {
                    return Number(match[0].replace(/,/g, ""));
                }
            }

            if (reviewMode) {
                const reviewNode = doc.querySelector(".review-count");

                if (reviewNode) {
                    const raw = reviewNode.textContent.trim();
                    const match = raw.match(/\d[\d,]*/);

                    if (match) {
                        return Number(match[0].replace(/,/g, ""));
                    }
                }
            }

            // Fallback: count rows if a count element is unavailable.
            const rows = doc.querySelectorAll("table tbody tr");
            return rows.length;
        } catch (error) {
            console.error("Dashboard count error:", url, error);
            return null;
        }
    }

    async function loadDashboardCounts() {
        const results = await Promise.all([
            readCount("/admin/users", ".user-count-number", false),
            readCount("/admin/users?role=owner", ".user-count-number", false),
            readCount("/admin/users?role=customer", ".user-count-number", false),
            readCount("/admin/businesses", ".business-count-number", false),
            readCount("/admin/reviews", ".review-count", true)
        ]);

        setCount(targets.users, results[0]);
        setCount(targets.owners, results[1]);
        setCount(targets.customers, results[2]);
        setCount(targets.businesses, results[3]);
        setCount(targets.reviews, results[4]);
    }

    loadDashboardCounts();
})();
</script>

