<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Users | Local Business</title>


    <!-- =========================================================
         GOOGLE FONTS
    ========================================================== -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
        rel="stylesheet"
    >


    <style>

        /* =========================================================
           RESET
        ========================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {
            font-family: "DM Sans", sans-serif;

            background: #f8f5f2;

            color: #171717;

            min-height: 100vh;
        }


        a {
            text-decoration: none;
        }


        /* =========================================================
           NAVBAR
        ========================================================== */

        .admin-navbar {
            width: 100%;

            height: 82px;

            background: #211f1f;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 7%;

            position: sticky;

            top: 0;

            z-index: 1000;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.12);
        }


        /* =========================================================
           BRAND
        ========================================================== */

        .admin-brand {
            display: flex;

            align-items: center;

            gap: 14px;

            color: #ffffff;
        }


        .admin-logo {
            width: 47px;

            height: 47px;

            border-radius: 9px;

            background: #a44141;

            color: #ffffff;

            display: flex;

            align-items: center;

            justify-content: center;

            font-family: "Space Grotesk", sans-serif;

            font-size: 18px;

            font-weight: 700;

            flex-shrink: 0;
        }


        .admin-brand-text {
            display: flex;

            align-items: center;
        }


        .admin-brand-title {
            font-family: "Space Grotesk", sans-serif;

            font-size: 20px;

            font-weight: 700;

            color: #ffffff;

            letter-spacing: -0.2px;
        }


        /* =========================================================
           LOGOUT
        ========================================================== */

        .logout-btn {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-width: 105px;

            height: 43px;

            padding: 0 22px;

            border-radius: 9px;

            background: #a44141;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            border: 1px solid #a44141;

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .logout-btn:hover {
            background: #8c3636;

            transform: translateY(-2px);

            box-shadow:
                0 8px 20px rgba(164, 65, 65, 0.28);
        }


        /* =========================================================
           MAIN
        ========================================================== */

        .admin-page {
            width: min(1200px, 90%);

            margin: 0 auto;

            padding: 60px 0 90px;
        }


        /* =========================================================
           BACK BUTTON
        ========================================================== */

        .back-button {
            display: inline-flex;

            align-items: center;

            gap: 8px;

            color: #963b3b;

            font-size: 15px;

            font-weight: 700;

            margin-bottom: 30px;

            transition:
                color 0.2s ease,
                transform 0.2s ease;
        }


        .back-button:hover {
            color: #6f2d2d;

            transform: translateX(-3px);
        }


        /* =========================================================
           PAGE HEADER
        ========================================================== */

        .page-header {
            margin-bottom: 38px;
        }


        .page-label {
            display: flex;

            align-items: center;

            gap: 9px;

            color: #963b3b;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            margin-bottom: 12px;
        }


        .page-label::before {
            content: "";

            width: 7px;

            height: 7px;

            border-radius: 50%;

            background: #ff725c;
        }


        .page-header h1 {
            font-family: "Space Grotesk", sans-serif;

            font-size: clamp(36px, 5vw, 52px);

            line-height: 1.05;

            font-weight: 700;

            color: #171717;

            margin-bottom: 12px;

            letter-spacing: -1.5px;
        }


        .page-header p {
            color: #756b66;

            font-size: 16px;

            line-height: 1.6;

            max-width: 680px;
        }


        /* =========================================================
           USER HERO
           MATCHES REVIEWS PAGE
        ========================================================== */

        .users-hero {
            position: relative;

            overflow: hidden;

            border-radius: 24px;

            padding: 38px 42px;

            margin-bottom: 30px;

            background:
                linear-gradient(
                    120deg,
                    #261719 0%,
                    #4b2527 45%,
                    #91462a 100%
                );

            color: #ffffff;

            box-shadow:
                0 20px 45px rgba(74, 43, 39, 0.16);
        }


        .users-hero::before {
            content: "";

            position: absolute;

            width: 230px;

            height: 230px;

            border-radius: 50%;

            border:
                1px solid rgba(255, 255, 255, 0.14);

            right: -55px;

            top: -95px;
        }


        .users-hero::after {
            content: "";

            position: absolute;

            width: 140px;

            height: 140px;

            border-radius: 50%;

            background:
                rgba(255, 114, 92, 0.18);

            right: 100px;

            bottom: -80px;

            filter: blur(5px);
        }


        .users-hero-content {
            position: relative;

            z-index: 2;
        }


        .users-hero h2 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 30px;

            margin-bottom: 8px;
        }


        .users-hero p {
            color: rgba(255, 255, 255, 0.78);

            font-size: 15px;

            line-height: 1.6;

            max-width: 850px;
        }


        /* =========================================================
           USERS CARD
           MATCHES REVIEWS CARD
        ========================================================== */

        .users-card {
            background: #ffffff;

            border: 1px solid #eee5df;

            border-radius: 22px;

            padding: 32px;

            box-shadow:
                0 15px 40px rgba(47, 31, 26, 0.07);

            overflow: hidden;
        }


        /* =========================================================
           CARD HEADER
        ========================================================== */

        .users-card-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 26px;
        }


        .users-heading {
            display: flex;

            align-items: center;

            gap: 13px;
        }


        .users-icon {
            width: 44px;

            height: 44px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 12px;

            background: #f7e9e5;

            font-size: 19px;

            flex-shrink: 0;
        }


        .users-heading h2 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 27px;

            color: #171717;

            margin-bottom: 3px;
        }


        .users-heading p {
            color: #857a74;

            font-size: 12px;
        }


        /* =========================================================
           USER COUNT
        ========================================================== */

        .user-count {
            padding: 8px 15px;

            border-radius: 30px;

            background: #f7e9e5;

            color: #963b3b;

            font-size: 13px;

            font-weight: 700;

            white-space: nowrap;
        }


        /* =========================================================
           FILTER AREA
        ========================================================== */

        .filter-row {
            display: flex;

            align-items: center;

            justify-content: flex-end;

            gap: 9px;

            margin-bottom: 20px;
        }


        .filter-row label {
            color: #77716d;

            font-size: 12px;

            font-weight: 600;
        }


        .role-filter select {
            min-width: 150px;

            height: 38px;

            padding: 0 34px 0 12px;

            border: 1px solid #ddd7d3;

            border-radius: 8px;

            background: #ffffff;

            color: #302d2b;

            font-family: inherit;

            font-size: 12px;

            font-weight: 600;

            outline: none;

            cursor: pointer;

            transition: 0.2s ease;
        }


        .role-filter select:hover {
            border-color: #c7bfba;
        }


        .role-filter select:focus {
            border-color: #963b3b;

            box-shadow:
                0 0 0 3px rgba(150, 59, 59, 0.08);
        }


        /* =========================================================
           TABLE WRAPPER
        ========================================================== */

        .table-wrapper {
            width: 100%;

            overflow-x: auto;

            border: 1px solid #eee5df;

            border-radius: 15px;
        }


        /* =========================================================
           TABLE
        ========================================================== */

        .users-table {
            width: 100%;

            border-collapse: collapse;

            min-width: 800px;
        }


        /* =========================================================
           TABLE HEADER
        ========================================================== */

        .users-table thead {
            background: #963b3b;
        }


        .users-table th {
            padding: 17px 18px;

            text-align: left;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 0.3px;

            white-space: nowrap;
        }


        .users-table th:first-child {
            border-top-left-radius: 14px;
        }


        .users-table th:last-child {
            border-top-right-radius: 14px;
        }


        /* =========================================================
           TABLE BODY
        ========================================================== */

        .users-table td {
            padding: 20px 18px;

            border-bottom:
                1px solid #eee8e3;

            font-size: 14px;

            color: #443c38;

            vertical-align: middle;
        }


        .users-table tbody tr {
            background: #ffffff;

            transition:
                background 0.2s ease;
        }


        .users-table tbody tr:hover {
            background: #fcf8f5;
        }


        .users-table tbody tr:last-child td {
            border-bottom: none;
        }


        /* =========================================================
           USER INFO
        ========================================================== */

        .user-info {
            display: flex;

            align-items: center;

            gap: 11px;
        }


        .user-avatar {
            width: 38px;

            height: 38px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background: #f7e9e5;

            color: #963b3b;

            font-size: 12px;

            font-weight: 700;

            flex-shrink: 0;
        }


        .user-name {
            color: #211b19;

            font-weight: 700;

            margin-bottom: 2px;
        }


        /* =========================================================
           EMAIL
        ========================================================== */

        .user-email {
            color: #857a74;

            font-size: 12px;

            word-break: break-word;
        }


        /* =========================================================
           ROLE BADGES
        ========================================================== */

        .role-badge {
            display: inline-flex;

            align-items: center;

            padding: 7px 12px;

            border-radius: 30px;

            font-size: 12px;

            font-weight: 700;
        }


        .role-badge.owner {
            background: #f7e9e5;

            color: #963b3b;
        }


        .role-badge.customer {
            background: #f1efec;

            color: #665f5a;
        }


        .role-badge.admin {
            background: #2e2927;

            color: #ffffff;
        }


        /* =========================================================
           CREATED DATE
        ========================================================== */

        .created-date {
            color: #756b66;

            white-space: nowrap;

            font-size: 13px;
        }


        /* =========================================================
           CURRENT ADMIN
        ========================================================== */

        .current-admin {
            display: inline-flex;

            align-items: center;

            gap: 6px;

            padding: 7px 11px;

            border-radius: 9px;

            background: #f7e9e5;

            color: #963b3b;

            font-size: 11px;

            font-weight: 700;
        }


        .current-admin::before {
            content: "✓";

            font-size: 11px;
        }


        /* =========================================================
           DELETE BUTTON
        ========================================================== */

        .delete-form {
            display: inline;
        }


        .delete-btn {
            border: none;

            cursor: pointer;

            padding: 10px 16px;

            border-radius: 9px;

            background: #f5e5e2;

            color: #a53b32;

            font-family: inherit;

            font-size: 13px;

            font-weight: 700;

            transition:
                background 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }


        .delete-btn:hover {
            background: #a53b32;

            color: #ffffff;

            transform: translateY(-1px);
        }


        /* =========================================================
           EMPTY STATE
        ========================================================== */

        .empty-state {
            padding: 70px 30px;

            text-align: center;
        }


        .empty-icon {
            width: 64px;

            height: 64px;

            margin: 0 auto 18px;

            border-radius: 18px;

            background: #f7e9e5;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 27px;
        }


        .empty-state h3 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 22px;

            margin-bottom: 7px;
        }


        .empty-state p {
            color: #817771;

            font-size: 14px;
        }


        /* =========================================================
           FOOTER
        ========================================================== */

        .admin-footer {
            text-align: center;

            color: #938780;

            font-size: 13px;

            margin-top: 40px;
        }


        /* =========================================================
           TABLET
        ========================================================== */

        @media (max-width: 800px) {

            .admin-navbar {
                padding: 0 5%;
            }


            .admin-page {
                width: 92%;

                padding-top: 45px;
            }


            .users-hero {
                padding: 30px 25px;

                border-radius: 18px;
            }


            .users-card {
                padding: 22px;

                border-radius: 18px;
            }


            .users-card-header {
                align-items: flex-start;

                flex-direction: column;
            }


            .filter-row {
                justify-content: flex-start;
            }

        }


        /* =========================================================
           MOBILE
        ========================================================== */

        @media (max-width: 550px) {

            .admin-navbar {
                height: 72px;

                padding: 0 18px;
            }


            .admin-logo {
                width: 42px;

                height: 42px;

                border-radius: 8px;

                font-size: 15px;
            }


            .admin-brand {
                gap: 10px;
            }


            .admin-brand-title {
                font-size: 16px;
            }


            .logout-btn {
                min-width: auto;

                height: 40px;

                padding: 0 15px;

                font-size: 12px;
            }


            .admin-page {
                width: 94%;

                padding-top: 35px;
            }


            .page-header h1 {
                font-size: 34px;

                letter-spacing: -1px;
            }


            .page-header p {
                font-size: 14px;
            }


            .users-hero {
                padding: 28px 22px;
            }


            .users-hero h2 {
                font-size: 24px;
            }


            .users-hero p {
                font-size: 14px;
            }


            .users-card {
                padding: 17px;
            }


            .users-heading h2 {
                font-size: 23px;
            }


            .users-heading p {
                font-size: 11px;
            }


            .filter-row {
                align-items: flex-start;

                flex-direction: column;
            }


            .role-filter {
                width: 100%;
            }


            .role-filter select {
                width: 100%;
            }

        }

    </style>

</head>


<body>


    <!-- =========================================================
         NAVBAR
    ========================================================== -->

    <nav class="admin-navbar">


        <a
            href="/admin"
            class="admin-brand"
        >


            <div class="admin-logo">
                L
            </div>


            <div class="admin-brand-text">

                <span class="admin-brand-title">
                    Local Business
                </span>

            </div>


        </a>


        <a
            href="/logout"
            class="logout-btn"
        >
            Logout
        </a>


    </nav>



    <!-- =========================================================
         MAIN PAGE
    ========================================================== -->

    <main class="admin-page">


        <!-- =====================================================
             BACK
        ====================================================== -->

        <a
            href="/admin"
            class="back-button"
        >
            ← Back to Admin Dashboard
        </a>



        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <section class="page-header">


            <div class="page-label">
                User Management
            </div>


            <h1>
                Manage Users
            </h1>


            <p>
                View and manage all users registered
                on the Local Business Directory.
            </p>


        </section>



        <!-- =====================================================
             HERO
        ====================================================== -->

        <section class="users-hero">


            <div class="users-hero-content">


                <h2>
                    User Management
                </h2>


                <p>
                    Manage customer and business owner accounts,
                    review account information, and maintain
                    a trusted local business directory.
                </p>


            </div>


        </section>



        <!-- =====================================================
             USERS CARD
        ====================================================== -->

        <section class="users-card">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="users-card-header">


                <div class="users-heading">


                    <div class="users-icon">
                        👥
                    </div>


                    <div>

                        <h2>
                            All Users
                        </h2>


                        <p>
                            Registered users and account information.
                        </p>

                    </div>


                </div>



                <div class="user-count">

                    <%= users.length %>

                    <%= users.length === 1
                        ? "User"
                        : "Users"
                    %>

                </div>


            </div>



            <!-- =================================================
                 FILTER
            ================================================== -->

            <div class="filter-row">


                <form
                    action="/admin/users"
                    method="GET"
                    class="role-filter"
                >


                    <label for="role">
                        Filter:
                    </label>


                    <select
                        id="role"
                        name="role"
                        onchange="this.form.submit()"
                    >


                        <option
                            value="all"
                            <%= selectedRole === "all" ? "selected" : "" %>
                        >
                            All Users
                        </option>


                        <option
                            value="owner"
                            <%= selectedRole === "owner" ? "selected" : "" %>
                        >
                            Business Owners
                        </option>


                        <option
                            value="customer"
                            <%= selectedRole === "customer" ? "selected" : "" %>
                        >
                            Customers
                        </option>


                    </select>


                </form>


            </div>



            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <% if (users.length === 0) { %>


                <div class="empty-state">


                    <div class="empty-icon">
                        👥
                    </div>


                    <h3>
                        No Users Found
                    </h3>


                    <p>
                        There are no users matching the selected filter.
                    </p>


                </div>


            <% } else { %>


                <!-- =================================================
                     TABLE
                ================================================== -->

                <div class="table-wrapper">


                    <table class="users-table">


                        <thead>


                            <tr>


                                <th>
                                    User
                                </th>


                                <th>
                                    Email
                                </th>


                                <th>
                                    Role
                                </th>


                                <th>
                                    Created
                                </th>


                                <th>
                                    Action
                                </th>


                            </tr>


                        </thead>



                        <tbody>


                            <% users.forEach(user => { %>


                                <tr>


                                    <!-- =================================
                                         USER
                                    ================================== -->

                                    <td>


                                        <div class="user-info">


                                            <div class="user-avatar">


                                                <%
                                                    const name =
                                                        user.name || "U";

                                                    const initial =
                                                        name
                                                            .charAt(0)
                                                            .toUpperCase();
                                                %>


                                                <%= initial %>


                                            </div>


                                            <div>


                                                <div class="user-name">

                                                    <%= user.name || "Unknown User" %>

                                                </div>


                                            </div>


                                        </div>


                                    </td>



                                    <!-- =================================
                                         EMAIL
                                    ================================== -->

                                    <td>


                                        <span class="user-email">

                                            <%= user.email %>

                                        </span>


                                    </td>



                                    <!-- =================================
                                         ROLE
                                    ================================== -->

                                    <td>


                                        <span
                                            class="role-badge <%= user.role %>"
                                        >


                                            <% if (user.role === "owner") { %>

                                                Business Owner


                                            <% } else if (user.role === "customer") { %>

                                                Customer


                                            <% } else { %>

                                                Admin

                                            <% } %>


                                        </span>


                                    </td>



                                    <!-- =================================
                                         CREATED
                                    ================================== -->

                                    <td>


                                        <span class="created-date">

                                            <%= user.createdAt
                                                ? new Date(
                                                    user.createdAt
                                                ).toLocaleDateString("en-IN")
                                                : "N/A"
                                            %>

                                        </span>


                                    </td>



                                    <!-- =================================
                                         ACTION
                                    ================================== -->

                                    <td>


                                        <% if (
                                            userId &&
                                            user._id.toString() === userId.toString()
                                        ) { %>


                                            <span class="current-admin">
                                                Current Admin
                                            </span>


                                        <% } else { %>


                                            <form
                                                action="/admin/users/delete/<%= user._id %>?role=<%= encodeURIComponent(selectedRole || 'all') %>"
                                                method="POST"
                                                class="delete-form"
                                                onsubmit="return confirm('Are you sure you want to delete this user?');"
                                            >


                                                <button
                                                    type="submit"
                                                    class="delete-btn"
                                                >
                                                    Delete
                                                </button>


                                            </form>


                                        <% } %>


                                    </td>


                                </tr>


                            <% }) %>


                        </tbody>


                    </table>


                </div>


            <% } %>


        </section>



        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <div class="admin-footer">

            Local Business Directory · Admin Panel

        </div>


    </main>


</body>

</html>