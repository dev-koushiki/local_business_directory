<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Manage Businesses | Local Business</title>


    <!-- =========================================================
         GOOGLE FONTS
    ========================================================== -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
        rel="stylesheet"
    >


    <style>

        /* =========================================================
           RESET
        ========================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {
            font-family: "DM Sans", sans-serif;

            background: #f8f5f2;

            color: #171717;

            min-height: 100vh;
        }


        a {
            text-decoration: none;
        }


        /* =========================================================
           NAVBAR
        ========================================================== */

        .admin-navbar {
            width: 100%;

            height: 82px;

            background: #211f1f;

            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 0 7%;

            position: sticky;

            top: 0;

            z-index: 1000;

            box-shadow:
                0 8px 25px rgba(0, 0, 0, 0.12);
        }


        /* =========================================================
           BRAND
        ========================================================== */

        .admin-brand {
            display: flex;

            align-items: center;

            gap: 14px;

            color: #ffffff;
        }


        .admin-logo {
            width: 47px;

            height: 47px;

            border-radius: 9px;

            background: #a44141;

            color: #ffffff;

            display: flex;

            align-items: center;

            justify-content: center;

            font-family: "Space Grotesk", sans-serif;

            font-size: 18px;

            font-weight: 700;

            flex-shrink: 0;
        }


        .admin-brand-text {
            display: flex;

            align-items: center;
        }


        .admin-brand-title {
            font-family: "Space Grotesk", sans-serif;

            font-size: 20px;

            font-weight: 700;

            color: #ffffff;

            letter-spacing: -0.2px;
        }


        /* =========================================================
           LOGOUT BUTTON
        ========================================================== */

        .logout-btn {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            min-width: 105px;

            height: 43px;

            padding: 0 22px;

            border-radius: 9px;

            background: #a44141;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            border: 1px solid #a44141;

            transition:
                background 0.2s ease,
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }


        .logout-btn:hover {
            background: #8c3636;

            transform: translateY(-2px);

            box-shadow:
                0 8px 20px rgba(164, 65, 65, 0.28);
        }


        /* =========================================================
           MAIN PAGE
        ========================================================== */

        .admin-page {
            width: min(1200px, 90%);

            margin: 0 auto;

            padding: 60px 0 90px;
        }


        /* =========================================================
           BACK BUTTON
        ========================================================== */

        .back-button {
            display: inline-flex;

            align-items: center;

            gap: 8px;

            color: #963b3b;

            font-size: 15px;

            font-weight: 700;

            margin-bottom: 30px;

            transition:
                color 0.2s ease,
                transform 0.2s ease;
        }


        .back-button:hover {
            color: #6f2d2d;

            transform: translateX(-3px);
        }


        /* =========================================================
           PAGE HEADER
        ========================================================== */

        .page-header {
            margin-bottom: 38px;
        }


        .page-label {
            display: flex;

            align-items: center;

            gap: 9px;

            color: #963b3b;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 1.5px;

            text-transform: uppercase;

            margin-bottom: 12px;
        }


        .page-label::before {
            content: "";

            width: 7px;

            height: 7px;

            border-radius: 50%;

            background: #ff725c;
        }


        .page-header h1 {
            font-family: "Space Grotesk", sans-serif;

            font-size: clamp(36px, 5vw, 52px);

            line-height: 1.05;

            font-weight: 700;

            color: #171717;

            margin-bottom: 12px;

            letter-spacing: -1.5px;
        }


        .page-header p {
            color: #756b66;

            font-size: 16px;

            line-height: 1.6;

            max-width: 720px;
        }


        /* =========================================================
           BUSINESS HERO
           SAME STYLE AS USER PAGE
        ========================================================== */

        .business-hero {
            position: relative;

            overflow: hidden;

            border-radius: 24px;

            padding: 38px 42px;

            margin-bottom: 30px;

            background:
                linear-gradient(
                    120deg,
                    #261719 0%,
                    #4b2527 45%,
                    #91462a 100%
                );

            color: #ffffff;

            box-shadow:
                0 20px 45px rgba(74, 43, 39, 0.16);
        }


        .business-hero::before {
            content: "";

            position: absolute;

            width: 230px;

            height: 230px;

            border-radius: 50%;

            border:
                1px solid rgba(255, 255, 255, 0.14);

            right: -55px;

            top: -95px;
        }


        .business-hero::after {
            content: "";

            position: absolute;

            width: 140px;

            height: 140px;

            border-radius: 50%;

            background:
                rgba(255, 114, 92, 0.18);

            right: 100px;

            bottom: -80px;

            filter: blur(5px);
        }


        .business-hero-content {
            position: relative;

            z-index: 2;
        }


        .business-hero h2 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 30px;

            margin-bottom: 8px;
        }


        .business-hero p {
            color: rgba(255, 255, 255, 0.78);

            font-size: 15px;

            line-height: 1.6;

            max-width: 850px;
        }


        /* =========================================================
           BUSINESS CARD
        ========================================================== */

        .business-card {
            background: #ffffff;

            border: 1px solid #eee5df;

            border-radius: 22px;

            padding: 32px;

            box-shadow:
                0 15px 40px rgba(47, 31, 26, 0.07);

            overflow: hidden;
        }


        /* =========================================================
           CARD HEADER
        ========================================================== */

        .business-card-header {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

            margin-bottom: 26px;
        }


        .business-heading {
            display: flex;

            align-items: center;

            gap: 13px;
        }


        .business-icon {
            width: 44px;

            height: 44px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 12px;

            background: #f7e9e5;

            font-size: 19px;

            flex-shrink: 0;
        }


        .business-heading h2 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 27px;

            color: #171717;

            margin-bottom: 3px;
        }


        .business-heading p {
            color: #857a74;

            font-size: 12px;
        }


        /* =========================================================
           BUSINESS COUNT
        ========================================================== */

        .business-count {
            padding: 8px 15px;

            border-radius: 30px;

            background: #f7e9e5;

            color: #963b3b;

            font-size: 13px;

            font-weight: 700;

            white-space: nowrap;
        }


        /* =========================================================
           TABLE WRAPPER
        ========================================================== */

        .table-wrapper {
            width: 100%;

            overflow-x: auto;

            border: 1px solid #eee5df;

            border-radius: 15px;
        }


        /* =========================================================
           TABLE
        ========================================================== */

        .business-table {
            width: 100%;

            border-collapse: collapse;

            min-width: 900px;
        }


        /* =========================================================
           TABLE HEADER
        ========================================================== */

        .business-table thead {
            background: #963b3b;
        }


        .business-table th {
            padding: 17px 18px;

            text-align: left;

            color: #ffffff;

            font-size: 13px;

            font-weight: 700;

            letter-spacing: 0.3px;

            white-space: nowrap;
        }


        .business-table th:first-child {
            border-top-left-radius: 14px;
        }


        .business-table th:last-child {
            border-top-right-radius: 14px;
        }


        /* =========================================================
           TABLE BODY
        ========================================================== */

        .business-table td {
            padding: 20px 18px;

            border-bottom:
                1px solid #eee8e3;

            font-size: 14px;

            color: #443c38;

            vertical-align: middle;
        }


        .business-table tbody tr {
            background: #ffffff;

            transition:
                background 0.2s ease;
        }


        .business-table tbody tr:hover {
            background: #fcf8f5;
        }


        .business-table tbody tr:last-child td {
            border-bottom: none;
        }


        /* =========================================================
           BUSINESS NAME
        ========================================================== */

        .business-name {
            font-family: "Space Grotesk", sans-serif;

            font-size: 14px;

            font-weight: 700;

            color: #211b19;

            white-space: nowrap;
        }


        /* =========================================================
           OWNER
        ========================================================== */

        .owner-info {
            display: flex;

            align-items: center;

            gap: 11px;
        }


        .owner-avatar {
            width: 38px;

            height: 38px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background: #f7e9e5;

            color: #963b3b;

            font-size: 12px;

            font-weight: 700;

            flex-shrink: 0;
        }


        .owner-name {
            color: #211b19;

            font-size: 13px;

            font-weight: 700;

            white-space: nowrap;
        }


        /* =========================================================
           EMAIL
        ========================================================== */

        .email {
            color: #857a74;

            font-size: 12px;

            word-break: break-word;
        }


        /* =========================================================
           CATEGORY
        ========================================================== */

        .category-badge {
            display: inline-flex;

            align-items: center;

            justify-content: center;

            padding: 7px 12px;

            border-radius: 30px;

            background: #f7e9e5;

            color: #963b3b;

            font-size: 12px;

            font-weight: 700;

            text-transform: capitalize;
        }


        /* =========================================================
           LOCATION
        ========================================================== */

        .location {
            max-width: 230px;

            line-height: 1.45;
        }


        .location-main {
            color: #36312e;

            font-size: 12px;

            font-weight: 600;
        }


        .location-city {
            display: block;

            margin-top: 3px;

            color: #8a827c;

            font-size: 11px;
        }


        /* =========================================================
           DELETE BUTTON
        ========================================================== */

        .delete-form {
            display: inline;
        }


        .delete-btn {
            border: none;

            cursor: pointer;

            padding: 10px 16px;

            border-radius: 9px;

            background: #f5e5e2;

            color: #a53b32;

            font-family: inherit;

            font-size: 13px;

            font-weight: 700;

            transition:
                background 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }


        .delete-btn:hover {
            background: #a53b32;

            color: #ffffff;

            transform: translateY(-1px);
        }


        /* =========================================================
           EMPTY STATE
        ========================================================== */

        .empty-state {
            padding: 70px 30px;

            text-align: center;
        }


        .empty-icon {
            width: 64px;

            height: 64px;

            margin: 0 auto 18px;

            border-radius: 18px;

            background: #f7e9e5;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 27px;
        }


        .empty-state h3 {
            font-family: "Space Grotesk", sans-serif;

            font-size: 22px;

            margin-bottom: 7px;
        }


        .empty-state p {
            color: #817771;

            font-size: 14px;
        }


        /* =========================================================
           FOOTER
        ========================================================== */

        .admin-footer {
            text-align: center;

            color: #938780;

            font-size: 13px;

            margin-top: 40px;
        }


        /* =========================================================
           TABLET
        ========================================================== */

        @media (max-width: 800px) {

            .admin-navbar {
                padding: 0 5%;
            }


            .admin-page {
                width: 92%;

                padding-top: 45px;
            }


            .business-hero {
                padding: 30px 25px;

                border-radius: 18px;
            }


            .business-card {
                padding: 22px;

                border-radius: 18px;
            }


            .business-card-header {
                align-items: flex-start;

                flex-direction: column;
            }

        }


        /* =========================================================
           MOBILE
        ========================================================== */

        @media (max-width: 550px) {

            .admin-navbar {
                height: 72px;

                padding: 0 18px;
            }


            .admin-logo {
                width: 42px;

                height: 42px;

                border-radius: 8px;

                font-size: 15px;
            }


            .admin-brand {
                gap: 10px;
            }


            .admin-brand-title {
                font-size: 16px;
            }


            .logout-btn {
                min-width: auto;

                height: 40px;

                padding: 0 15px;

                font-size: 12px;
            }


            .admin-page {
                width: 94%;

                padding-top: 35px;
            }


            .page-header h1 {
                font-size: 34px;

                letter-spacing: -1px;
            }


            .page-header p {
                font-size: 14px;
            }


            .business-hero {
                padding: 28px 22px;
            }


            .business-hero h2 {
                font-size: 24px;
            }


            .business-hero p {
                font-size: 14px;
            }


            .business-card {
                padding: 17px;
            }


            .business-heading h2 {
                font-size: 23px;
            }


            .business-heading p {
                font-size: 11px;
            }

        }

    </style>

</head>


<body>


    <!-- =========================================================
         NAVBAR
    ========================================================== -->

    <nav class="admin-navbar">


        <a
            href="/admin"
            class="admin-brand"
        >


            <div class="admin-logo">
                L
            </div>


            <div class="admin-brand-text">

                <span class="admin-brand-title">
                    Local Business
                </span>

            </div>


        </a>


        <a
            href="/logout"
            class="logout-btn"
        >
            Logout
        </a>


    </nav>



    <!-- =========================================================
         MAIN PAGE
    ========================================================== -->

    <main class="admin-page">


        <!-- =====================================================
             BACK BUTTON
        ====================================================== -->

        <a
            href="/admin"
            class="back-button"
        >
            ← Back to Admin Dashboard
        </a>



        <!-- =====================================================
             PAGE HEADER
        ====================================================== -->

        <section class="page-header">


            <div class="page-label">
                Business Management
            </div>


            <h1>
                Manage Businesses
            </h1>


            <p>
                View, monitor and manage all businesses
                registered on the Local Business Directory.
            </p>


        </section>



        <!-- =====================================================
             BUSINESS HERO
        ====================================================== -->

        <section class="business-hero">


            <div class="business-hero-content">


                <h2>
                    Business Management
                </h2>


                <p>
                    Manage registered local businesses,
                    review owner information, monitor categories,
                    and maintain a trusted business directory.
                </p>


            </div>


        </section>



        <!-- =====================================================
             BUSINESS CARD
        ====================================================== -->

        <section class="business-card">


            <!-- =================================================
                 CARD HEADER
            ================================================== -->

            <div class="business-card-header">


                <div class="business-heading">


                    <div class="business-icon">
                        🏢
                    </div>


                    <div>

                        <h2>
                            All Businesses
                        </h2>


                        <p>
                            Businesses currently registered
                            in the directory.
                        </p>

                    </div>


                </div>



                <div class="business-count">

                    <%= businesses.length %>

                    <%= businesses.length === 1
                        ? "Business"
                        : "Businesses"
                    %>

                </div>


            </div>



            <!-- =================================================
                 EMPTY STATE
            ================================================== -->

            <% if (businesses.length === 0) { %>


                <div class="empty-state">


                    <div class="empty-icon">
                        🏢
                    </div>


                    <h3>
                        No Businesses Found
                    </h3>


                    <p>
                        No businesses have been registered
                        on the platform.
                    </p>


                </div>


            <% } else { %>


                <!-- =================================================
                     TABLE
                ================================================== -->

                <div class="table-wrapper">


                    <table class="business-table">


                        <thead>


                            <tr>


                                <th>
                                    Business
                                </th>


                                <th>
                                    Owner
                                </th>


                                <th>
                                    Email
                                </th>


                                <th>
                                    Category
                                </th>


                                <th>
                                    Location
                                </th>


                                <th>
                                    Action
                                </th>


                            </tr>


                        </thead>



                        <tbody>


                            <% businesses.forEach(business => { %>


                                <tr>


                                    <!-- =================================
                                         BUSINESS
                                    ================================== -->

                                    <td>


                                        <div class="business-name">

                                            <%= business.name || "Unnamed Business" %>

                                        </div>


                                    </td>



                                    <!-- =================================
                                         OWNER
                                    ================================== -->

                                    <td>


                                        <div class="owner-info">


                                            <div class="owner-avatar">


                                                <%
                                                    let ownerName =
                                                        business.owner
                                                            ? business.owner.name
                                                            : "U";

                                                    let ownerInitial =
                                                        ownerName
                                                            .charAt(0)
                                                            .toUpperCase();
                                                %>


                                                <%= ownerInitial %>


                                            </div>


                                            <div class="owner-name">

                                                <%= business.owner
                                                    ? business.owner.name
                                                    : "Unknown" %>

                                            </div>


                                        </div>


                                    </td>



                                    <!-- =================================
                                         EMAIL
                                    ================================== -->

                                    <td>


                                        <span class="email">

                                            <%= business.owner
                                                ? business.owner.email
                                                : "Unknown" %>

                                        </span>


                                    </td>



                                    <!-- =================================
                                         CATEGORY
                                    ================================== -->

                                    <td>


                                        <span class="category-badge">

                                            <%= business.category || "N/A" %>

                                        </span>


                                    </td>



                                    <!-- =================================
                                         LOCATION
                                    ================================== -->

                                    <td>


                                        <div class="location">


                                            <div class="location-main">

                                                <%= business.address || "Address unavailable" %>

                                            </div>


                                            <% if (business.city) { %>


                                                <span class="location-city">

                                                    <%= business.city %>

                                                </span>


                                            <% } %>


                                        </div>


                                    </td>



                                    <!-- =================================
                                         ACTION
                                    ================================== -->

                                    <td>


                                        <form
                                            action="/admin/businesses/delete/<%= business._id %>"
                                            method="POST"
                                            class="delete-form"
                                            onsubmit="return confirm('Are you sure you want to delete this business?');"
                                        >


                                            <button
                                                type="submit"
                                                class="delete-btn"
                                            >
                                                Delete
                                            </button>


                                        </form>


                                    </td>


                                </tr>


                            <% }) %>


                        </tbody>


                    </table>


                </div>


            <% } %>


        </section>



        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <div class="admin-footer">

            Local Business Directory · Admin Panel

        </div>


    </main>


</body>

</html>