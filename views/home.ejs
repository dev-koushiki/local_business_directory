<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Local Business Directory | Discover Local</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <!-- Main stylesheet -->
    <link
        rel="stylesheet"
        href="/css/style.css"
    >


    <style>
        /* =========================================================
           FEATURES - PREMIUM WATERMARK HOVER FLIP CARDS
        ========================================================= */

        .how-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 24px;
            margin-top: 50px;
        }

        .feature-flip-card {
            height: 300px;
            perspective: 1400px;
            cursor: pointer;
            position: relative;
        }

        .feature-flip-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transition: transform 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
        }

        /* Flip automatically when the mouse is over the card. */
        .feature-flip-card:hover .feature-flip-inner {
            transform: rotateY(180deg);
        }

        .feature-flip-front,
        .feature-flip-back {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            box-sizing: border-box;
            border-radius: 26px;
            overflow: hidden;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }

        .feature-flip-front {
            border: 1px solid rgba(142, 61, 58, 0.12);
            padding: 32px;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: flex-end;
            background: linear-gradient(145deg, #fffafa 0%, #fff4ef 100%);
            box-shadow: 0 12px 32px rgba(35, 20, 18, 0.08);
            position: absolute;
            isolation: isolate;
            transition: box-shadow 0.25s ease, border-color 0.25s ease;
        }

        /* Large watermark emoji across the card. */
        .feature-flip-front::before {
            content: attr(data-watermark);
            position: absolute;
            right: -42px;
            top: -58px;
            width: 260px;
            height: 260px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 205px;
            line-height: 1;
            opacity: 0.16;
            filter: saturate(0.85);
            transform: rotate(-8deg);
            pointer-events: none;
            z-index: 0;
        }

        .feature-flip-front::after {
            content: '';
            position: absolute;
            width: 78px;
            height: 5px;
            left: 32px;
            bottom: 24px;
            border-radius: 99px;
            background: linear-gradient(90deg, #9a3f3b, #ff735c);
            opacity: 0.85;
            z-index: 2;
        }

        .feature-flip-card:hover .feature-flip-front {
            box-shadow: 0 24px 55px rgba(50, 25, 22, 0.15);
            border-color: rgba(154, 63, 59, 0.25);
        }

        /* Individual card colors */
        .feature-flip-card:nth-child(1) .feature-flip-front {
            background: linear-gradient(145deg, #fff8f8 0%, #ffe3e1 100%);
        }

        .feature-flip-card:nth-child(2) .feature-flip-front {
            background: linear-gradient(145deg, #fff8fa 0%, #ffe4e9 100%);
        }

        .feature-flip-card:nth-child(3) .feature-flip-front {
            background: linear-gradient(145deg, #fffdf5 0%, #fff0c9 100%);
        }

        .feature-flip-card:nth-child(4) .feature-flip-front {
            background: linear-gradient(145deg, #f7fff5 0%, #e3f3d8 100%);
        }

        .feature-flip-card:nth-child(5) .feature-flip-front {
            background: linear-gradient(145deg, #f5f7ff 0%, #e1e7ff 100%);
        }

        .feature-flip-card:nth-child(6) .feature-flip-front {
            background: linear-gradient(145deg, #faf7ff 0%, #e9e1ff 100%);
        }

        .feature-flip-card:nth-child(7) .feature-flip-front {
            background: linear-gradient(145deg, #f2faff 0%, #dceeff 100%);
        }

        .feature-flip-card:nth-child(8) .feature-flip-front {
            background: linear-gradient(145deg, #fff6f8 0%, #ffdfe7 100%);
        }

        /* Small emoji above the title. */
        .feature-front-content {
            position: relative;
            z-index: 3;
            width: 100%;
        }

        .feature-flip-icon {
            position: relative;
            width: 64px;
            height: 64px;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            line-height: 1;
            background: #171516;
            box-shadow: 0 10px 22px rgba(25, 18, 18, 0.18);
            margin-bottom: 18px;
            z-index: 4;
        }

        .feature-flip-front h3 {
            margin: 0;
            max-width: 250px;
            font-size: 23px;
            line-height: 1.15;
            font-weight: 700;
            color: #171516;
            position: relative;
            z-index: 3;
        }

        .feature-flip-message {
            display: none !important;
        }

        .feature-flip-back {
            transform: rotateY(180deg);
            background:
                radial-gradient(circle at 90% 15%, rgba(255, 125, 94, 0.35), transparent 30%),
                linear-gradient(145deg, #1a1516 0%, #3b2020 55%, #74382d 100%);
            border: 1px solid rgba(255, 255, 255, 0.10);
            padding: 38px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            box-shadow: 0 24px 55px rgba(35, 17, 15, 0.22);
        }

        .feature-flip-back::before {
            content: '';
            position: absolute;
            width: 190px;
            height: 190px;
            right: -90px;
            top: -90px;
            border: 1px solid rgba(255, 255, 255, 0.16);
            border-radius: 50%;
        }

        .feature-flip-back::after {
            content: '';
            position: absolute;
            width: 110px;
            height: 110px;
            left: -60px;
            bottom: -60px;
            border: 1px solid rgba(255, 255, 255, 0.10);
            border-radius: 50%;
        }

        /* The back shows ONLY the description. */
        .feature-flip-back .feature-flip-back-icon,
        .feature-flip-back h3,
        .feature-flip-back .feature-flip-back-hint {
            display: none !important;
        }

        .feature-flip-back p {
            display: block;
            margin: 0;
            max-width: 270px;
            color: rgba(255, 255, 255, 0.92);
            font-size: 15px;
            line-height: 1.8;
            font-weight: 400;
            position: relative;
            z-index: 1;
        }

        @media (max-width: 1100px) {
            .how-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @media (max-width: 650px) {
            .how-grid {
                grid-template-columns: 1fr;
            }

            .feature-flip-card {
                height: 290px;
            }
        }

        /* =====================================================
           PASSWORD VISIBILITY + FORGOT PASSWORD TOAST
        ===================================================== */
        .password-field-wrapper {
            position: relative;
            width: 100%;
        }

        .password-field-wrapper input {
            width: 100%;
            padding-right: 50px !important;
            box-sizing: border-box;
        }

        .password-toggle {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            width: 32px;
            height: 32px;
            border: 0;
            background: transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            cursor: pointer;
            color: #777;
            z-index: 2;
        }

        .password-toggle:hover {
            color: #8B3A3A;
        }

        .password-toggle svg {
            width: 20px;
            height: 20px;
            pointer-events: none;
        }

        .forgot-password-row {
            display: flex;
            justify-content: flex-end;
            margin-top: 7px;
            margin-bottom: 18px;
        }

        .forgot-password-row button {
            border: 0;
            background: transparent;
            padding: 0;
            color: #8B3A3A;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.2;
            cursor: pointer;
        }

        .forgot-password-row button:hover {
            text-decoration: underline;
        }

        /* Keep messages above BOTH login and forgot-password overlays. */
        #authToast.auth-toast {
            position: fixed !important;
            left: 50% !important;
            top: 24px !important;
            right: auto !important;
            bottom: auto !important;
            transform: translateX(-50%) translateY(-12px) !important;
            z-index: 100000 !important;
            pointer-events: none;
        }

        #authToast.auth-toast.show {
            transform: translateX(-50%) translateY(0) !important;
        }

        @media (max-width: 600px) {
            #authToast.auth-toast {
                width: calc(100% - 32px);
                left: 16px !important;
                transform: translateY(-12px) !important;
            }

            #authToast.auth-toast.show {
                transform: translateY(0) !important;
            }
        }

    
/* =========================================================
   DISCOVER CARDS - ULTRA MODERN / EDITORIAL EDITION
   ========================================================= */

.discover-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:22px;
    margin-top:46px;
}

/* Main card */
.discover-card{
    --accent:#ff6655;
    position:relative;
    height:342px;
    min-height:342px;
    padding:24px;
    border-radius:32px;
    overflow:hidden;
    isolation:isolate;
    display:flex;
    flex-direction:column;
    text-decoration:none;
    color:#171516;
    border:1px solid rgba(38,28,27,.10);
    box-shadow:
        0 20px 45px rgba(38,27,24,.075),
        0 3px 10px rgba(38,27,24,.035),
        inset 0 1px 0 rgba(255,255,255,.95);
    transition:
        transform .42s cubic-bezier(.2,.75,.25,1),
        box-shadow .42s ease,
        border-color .42s ease;
}

/* Individual card palettes */
.discover-card:nth-child(1){
    --accent:#ff624f;
    background:
        radial-gradient(circle at 86% 11%,rgba(255,255,255,.95),transparent 24%),
        linear-gradient(150deg,#fffaf8 0%,#ffe9e4 45%,#ffd7cf 100%);
}

.discover-card:nth-child(2){
    --accent:#e92d82;
    background:
        radial-gradient(circle at 87% 11%,rgba(255,255,255,.95),transparent 24%),
        linear-gradient(150deg,#fffafd 0%,#f8e5f2 45%,#f0d3e8 100%);
}

.discover-card:nth-child(3){
    --accent:#eeb113;
    background:
        radial-gradient(circle at 87% 11%,rgba(255,255,255,.95),transparent 24%),
        linear-gradient(150deg,#fffef9 0%,#fff2d5 45%,#ffe4ac 100%);
}

/* Ambient decorative rings */
.discover-card::before{
    content:"";
    position:absolute;
    width:250px;
    height:250px;
    right:-88px;
    top:-108px;
    border-radius:50%;
    background:rgba(255,255,255,.31);
    box-shadow:
        0 0 0 1px rgba(255,255,255,.30),
        0 0 0 22px rgba(255,255,255,.065),
        0 0 0 44px rgba(255,255,255,.035);
    z-index:-3;
    transition:transform .55s ease;
}

.discover-card::after{
    content:"";
    position:absolute;
    width:180px;
    height:180px;
    left:-112px;
    bottom:-125px;
    border-radius:50%;
    background:rgba(255,255,255,.30);
    z-index:-3;
}

.discover-card:hover{
    transform:translateY(-12px);
    border-color:rgba(255,255,255,.95);
    box-shadow:
        0 32px 68px rgba(38,27,24,.145),
        0 8px 20px rgba(38,27,24,.055),
        inset 0 1px 0 #fff;
}

.discover-card:hover::before{
    transform:scale(1.13) translate(-4px,4px);
}

/* Top metadata */
.discover-card-top{
    position:relative;
    z-index:8;
    width:100%;
    height:155px;
    display:flex;
    align-items:flex-start;
}

/* Modern icon */
.discover-icon{
    position:relative;
    width:60px;
    height:60px;
    flex:0 0 60px;
    border-radius:19px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:rgba(19,17,18,.98);
    color:#fff;
    font-size:28px;
    line-height:1;
    border:1px solid rgba(255,255,255,.16);
    box-shadow:
        0 14px 28px rgba(18,14,14,.20),
        inset 0 1px 0 rgba(255,255,255,.13);
    transition:
        transform .35s cubic-bezier(.2,.75,.25,1),
        box-shadow .35s ease;
}

.discover-icon::before{
    content:"";
    position:absolute;
    inset:7px;
    border-radius:13px;
    border:1px solid rgba(255,255,255,.08);
}

.discover-card:hover .discover-icon{
    transform:translateY(-5px) rotate(-4deg) scale(1.05);
    box-shadow:
        0 19px 35px rgba(18,14,14,.26),
        inset 0 1px 0 rgba(255,255,255,.16);
}

/* Feature label in top-right */
.discover-card-top::before{
    content:"LOCAL / 01";
    position:absolute;
    right:3px;
    top:5px;
    padding:7px 10px;
    border-radius:999px;
    background:rgba(255,255,255,.36);
    border:1px solid rgba(255,255,255,.45);
    color:rgba(30,24,23,.50);
    font-size:8px;
    font-weight:800;
    letter-spacing:.14em;
    backdrop-filter:blur(10px);
}

.discover-card:nth-child(2) .discover-card-top::before{
    content:"LOCAL / 02";
}

.discover-card:nth-child(3) .discover-card-top::before{
    content:"LOCAL / 03";
}

/* Illustration */
.discover-illustration{
    position:absolute;
    right:-13px;
    top:-31px;
    width:225px;
    height:185px;
    z-index:2;
    pointer-events:none;
    display:flex;
    align-items:center;
    justify-content:center;
}

.discover-illustration::before{
    content:"";
    position:absolute;
    width:185px;
    height:122px;
    right:0;
    top:29px;
    border-radius:58% 42% 50% 50%;
    background:rgba(255,255,255,.42);
    transform:rotate(-7deg);
    box-shadow:
        inset 0 1px 0 rgba(255,255,255,.55),
        0 8px 25px rgba(255,255,255,.13);
}

.discover-illustration::after{
    content:"";
    position:absolute;
    width:126px;
    height:126px;
    right:29px;
    top:25px;
    border-radius:50%;
    border:1px solid rgba(255,255,255,.40);
    box-shadow:
        0 0 0 12px rgba(255,255,255,.055),
        0 0 0 24px rgba(255,255,255,.025);
}

.discover-art{
    position:relative;
    z-index:5;
    width:198px;
    height:164px;
    overflow:visible;
    filter:
        drop-shadow(0 15px 13px rgba(49,33,30,.10));
    transition:
        transform .5s cubic-bezier(.2,.75,.25,1),
        filter .5s ease;
}

.discover-card:hover .discover-art{
    transform:translateY(-9px) scale(1.075);
    filter:
        drop-shadow(0 22px 17px rgba(49,33,30,.15));
}

.discover-card:nth-child(1) .discover-art{
    width:212px;
    height:168px;
}

.discover-card:nth-child(2) .discover-art{
    width:196px;
}

.discover-card:nth-child(3) .discover-art{
    width:204px;
}

.discover-card:nth-child(2) .discover-illustration::before{
    background:rgba(242,158,204,.24);
}

.discover-card:nth-child(3) .discover-illustration::before{
    background:rgba(255,211,71,.28);
}

/* Bottom glass content dock */
.discover-card-content{
    position:relative;
    z-index:10;
    margin-top:auto;
    min-width:0;
    padding:17px 18px 17px;
    border-radius:21px;
    background:rgba(255,255,255,.43);
    border:1px solid rgba(255,255,255,.54);
    box-shadow:
        0 10px 25px rgba(60,42,39,.055),
        inset 0 1px 0 rgba(255,255,255,.62);
    backdrop-filter:blur(13px);
    -webkit-backdrop-filter:blur(13px);
    transition:
        background .35s ease,
        transform .35s ease,
        box-shadow .35s ease;
}

.discover-card:hover .discover-card-content{
    background:rgba(255,255,255,.55);
    transform:translateY(-2px);
    box-shadow:
        0 14px 29px rgba(60,42,39,.075),
        inset 0 1px 0 rgba(255,255,255,.75);
}

/* Number */
.discover-number{
    display:flex;
    align-items:center;
    gap:8px;
    margin:0 0 7px;
    color:rgba(23,21,22,.50);
    font-size:9px;
    font-weight:800;
    letter-spacing:.17em;
}

.discover-number::after{
    content:"";
    width:22px;
    height:2px;
    border-radius:99px;
    background:var(--accent);
    opacity:.80;
}

/* Heading */
.discover-card h3{
    margin:0;
    max-width:320px;
    font-family:"Space Grotesk",sans-serif;
    font-size:21px;
    line-height:1.08;
    font-weight:700;
    letter-spacing:-.035em;
    color:#171516;
}

/* Description */
.discover-card p{
    margin:7px 0 0;
    max-width:305px;
    color:#665b58;
    font-size:11.8px;
    line-height:1.45;
}

/* CTA row */
.discover-link{
    display:inline-flex;
    align-items:center;
    gap:7px;
    margin-top:10px;
    padding-bottom:2px;
    color:#171516;
    font-size:11px;
    font-weight:800;
    border-bottom:1px solid rgba(23,21,22,.18);
    transition:
        gap .25s ease,
        border-color .25s ease;
}

.discover-link span{
    font-size:15px;
    line-height:1;
    transition:transform .25s ease;
}

.discover-card:hover .discover-link{
    gap:10px;
    border-color:var(--accent);
}

.discover-card:hover .discover-link span{
    transform:translateX(4px);
}

/* Accent micro-line */
.discover-card-content::after{
    content:"";
    position:absolute;
    left:18px;
    bottom:-8px;
    width:34px;
    height:2px;
    border-radius:99px;
    background:var(--accent);
    opacity:.65;
    transition:width .3s ease;
}

.discover-card:hover .discover-card-content::after{
    width:58px;
}

/* Circular action button */
.discover-card-action{
    position:absolute;
    right:19px;
    bottom:19px;
    z-index:12;
    width:48px;
    height:48px;
    border-radius:50%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#fff;
    background:var(--accent);
    border:2px solid rgba(255,255,255,.82);
    box-shadow:
        0 10px 22px rgba(37,27,25,.13),
        inset 0 1px 0 rgba(255,255,255,.32);
    font-size:21px;
    line-height:1;
    transition:
        transform .34s cubic-bezier(.2,.75,.25,1),
        box-shadow .34s ease;
}

.discover-card:hover .discover-card-action{
    transform:translateY(-4px) scale(1.08);
    box-shadow:
        0 15px 28px rgba(37,27,25,.17),
        inset 0 1px 0 rgba(255,255,255,.38);
}

/* Keep CTA button visually integrated with the glass dock */
.discover-card:nth-child(1) .discover-card-action{
    background:linear-gradient(145deg,#ff715f,#f85645);
}

.discover-card:nth-child(2) .discover-card-action{
    background:linear-gradient(145deg,#f04491,#d92878);
}

.discover-card:nth-child(3) .discover-card-action{
    background:linear-gradient(145deg,#f6c02a,#e9a90b);
}

/* Remove legacy watermark if present */
.discover-watermark{
    display:none !important;
}

/* Desktop refinement */
@media(min-width:1250px){
    .discover-card{
        height:348px;
        min-height:348px;
    }

    .discover-card-top{
        height:160px;
    }

    .discover-card-content{
        padding:18px 19px 18px;
    }
}

/* Tablet */
@media(max-width:1000px){
    .discover-grid{
        grid-template-columns:1fr;
        gap:20px;
    }

    .discover-card{
        height:300px;
        min-height:300px;
    }

    .discover-card-top{
        height:115px;
    }

    .discover-illustration{
        right:-12px;
        top:-25px;
    }
}

/* Mobile */
@media(max-width:650px){
    .discover-grid{
        grid-template-columns:1fr;
        gap:16px;
        margin-top:32px;
    }

    .discover-card{
        height:275px;
        min-height:275px;
        padding:20px;
        border-radius:25px;
    }

    .discover-card-top{
        height:100px;
    }

    .discover-icon{
        width:54px;
        height:54px;
        flex-basis:54px;
        border-radius:17px;
        font-size:25px;
    }

    .discover-card-top::before{
        top:3px;
        right:0;
        font-size:7px;
    }

    .discover-illustration{
        right:-25px;
        top:-17px;
        transform:scale(.84);
        transform-origin:top right;
    }

    .discover-card-content{
        padding:15px 15px 16px;
        border-radius:18px;
    }

    .discover-card h3{
        font-size:19px;
    }

    .discover-card p{
        max-width:245px;
        font-size:11.5px;
    }

    .discover-card-action{
        right:15px;
        bottom:15px;
        width:45px;
        height:45px;
        font-size:19px;
    }
}
/* =========================================================
   PREMIUM CATEGORY CARDS
   Only styles the Categories section
   ========================================================= */

.categories-section .categories-grid{
    display:grid !important;
    grid-template-columns:repeat(4,minmax(0,1fr)) !important;
    gap:20px !important;
    margin-top:34px !important;
}

.categories-section .category-card{
    position:relative !important;
    min-height:205px !important;
    height:205px !important;
    padding:24px !important;
    border-radius:25px !important;
    overflow:hidden !important;
    isolation:isolate !important;
    display:flex !important;
    flex-direction:column !important;
    justify-content:space-between !important;
    align-items:flex-start !important;
    text-decoration:none !important;
